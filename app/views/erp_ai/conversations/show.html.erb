<% content_for :title, t("ai.conversations.title", id: @conversation.id) %>
<% content_for :page_heading, t("ai.conversations.page_heading") %>

<div class="ai-conversation-heading">
  <div>
    <h1 class="page-title"><%= t("ai.conversations.title", id: @conversation.id) %></h1>
    <p class="ai-conversation-heading__meta">
      <span><%= @conversation.agent.name %></span>
      <time datetime="<%= @conversation.created_at.iso8601 %>"><%= display_time(@conversation.created_at) %></time>
    </p>
  </div>
  <div class="ai-conversation-heading__actions hidden">
    <% if can?(:manage_users) %>
      <%= link_to edit_admin_agent_path(@conversation.agent.code),
                  class: "button button-secondary",
                  target: "_blank",
                  rel: "noopener",
                  data: { turbo: false } do %>
        <i class="bi bi-pencil-square" aria-hidden="true"></i>
        <%= t("ai.conversations.edit_agent") %>
      <% end %>
    <% end %>
    <%= link_to root_path,
                class: "button button-secondary",
                data: { controller: "history-navigation", action: "history-navigation#back" } do %>
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
      <%= t("common.actions.back") %>
    <% end %>
    <%= link_to "yclaw://conversation?conversation_id=#{@conversation.id}",
                class: "button",
                style: "display: none;",
                data: { turbo: false } do %>
      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
      <%= t("ai.conversations.follow_up_in_yclaw") %>
    <% end %>
    <% if @linked_event %>
      <%= link_to report_sku_path(@linked_event.ai_diagnosis.sku.sku_code, tab: "ai_inventory_health", locale: params[:locale].presence),
                  class: "button button-secondary" do %>
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <%= t("ai.conversations.back_to_diagnosis") %>
      <% end %>
    <% end %>
  </div>
</div>

<details class="ai-conversation-context">
  <summary class="ai-conversation-context__summary">
    <span>
      <i class="bi bi-braces" aria-hidden="true"></i>
      <%= t("ai.conversations.context.title") %>
    </span>
    <i class="bi bi-chevron-down ai-conversation-context__chevron" aria-hidden="true"></i>
  </summary>
  <div class="ai-conversation-context__body" data-controller="markdown">
    <pre class="code-viewer ai-conversation-context__source" data-markdown-target="source"><%= ai_conversation_context_markdown(@conversation.context) %></pre>
    <article class="gbrain-markdown" data-markdown-target="output" hidden></article>
  </div>
</details>

<section class="ai-conversation" aria-label="<%= t("ai.conversations.messages_aria_label") %>">
  <%= turbo_stream_from @conversation %>

  <div id="conversation_messages"
       class="ai-conversation__messages"
       data-controller="conversation-thread"
       data-conversation-thread-tool-exchange-label-value="<%= t("ai.conversations.tool_exchange") %>">
    <%= render "erp_ai/conversations/messages", messages: @messages %>
  </div>

  <%= render "erp_ai/conversations/composer",
             conversation: @conversation,
             message: @message,
             busy: @conversation.responding? %>
</section>
