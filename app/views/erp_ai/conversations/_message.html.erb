<% tool_calls = ai_conversation_tool_calls(message) %>
<% tool_response = message.role == "tool" %>
<% message_parts = tool_calls.any? ? tool_calls : [nil] %>
<% message_parts.each_with_index do |tool_call, index| %>
  <% tool_request = !tool_call.nil? %>
  <% part_id = index.zero? ? dom_id(message) : "#{dom_id(message)}_tool_call_#{index + 1}" %>
  <% tool_call_id = tool_request ? ai_conversation_tool_call_id(tool_call) : ai_conversation_tool_response_id(message) %>
  <article id="<%= part_id %>"
           class="<%= class_names("ai-conversation-message", "ai-conversation-message--#{message.role}", "ai-conversation-message--tool-request": tool_request) %>"
           data-tool-request="<%= tool_request %>"
           data-tool-response="<%= tool_response %>"
           data-tool-call-id="<%= tool_call_id %>">
    <header class="ai-conversation-message__header">
      <span class="ai-conversation-message__role">
        <i class="bi <%= tool_request || tool_response ? "bi-wrench-adjustable" : (message.role == "assistant" ? "bi-stars" : "bi-person") %>" aria-hidden="true"></i>
        <%= if tool_request
              t("ai.conversations.tool_call")
            elsif tool_response
              t("ai.conversations.tool_result")
            else
              ai_conversation_role_label(message.role)
            end %>
      </span>
      <time datetime="<%= message.created_at.iso8601 %>"><%= local_assigns[:displayed_at] || display_time(message.created_at) %></time>
    </header>

    <% if message.images.attached? %>
      <div class="ai-conversation-message__images">
        <% message.images.each do |image| %>
          <%= link_to rails_blob_path(image, disposition: "inline", only_path: true),
                      target: "_blank",
                      rel: "noopener",
                      class: "ai-conversation-message__image-link" do %>
            <%= image_tag rails_blob_path(image, disposition: "inline", only_path: true),
                          alt: t("ai.conversations.image_alt", filename: image.filename),
                          loading: "lazy",
                          class: "ai-conversation-message__image" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= render "erp_ai/conversations/message_body",
               message: message,
               body_id: "#{part_id}_body",
               content: tool_request ? ai_conversation_tool_call_markdown(tool_call, include_tool_label: false) : ai_conversation_message_markdown(message, include_tool_label: !tool_response),
               streaming: false %>
  </article>
<% end %>
