<% content_for :title, t("reports.sku_detail.planner.plan_title", id: @plan.id) %>
<% content_for :page_heading, t("reports.sku_detail.sections.sku_planner") %>

<div class="sku-plan-detail">
  <header class="sku-plan-detail__header">
    <div class="sku-plan-detail__heading">
      <p class="resource-eyebrow"><%= @sku.sku_code %> / <%= t("reports.sku_detail.sections.sku_planner") %></p>
      <h1 class="page-title"><%= t("reports.sku_detail.planner.plan_title", id: @plan.id) %></h1>
      <p class="sku-plan-detail__product"><%= report_value(@sku.product_name) %></p>
    </div>
    <div class="sku-plan-detail__actions">
      <% if can?(:manage_skus) && @plan.evaluation_status.in?(%w[pending insufficient_data failed]) %>
        <%= button_to t("reports.sku_detail.planner.evaluate_again"), evaluate_report_sku_operation_plan_path(@sku.sku_code, @plan, locale: params[:locale].presence),
                      method: :post, class: "button button-secondary" %>
      <% end %>
      <% if can?(:manage_skus) && @plan.active? %>
        <%= button_to t("reports.sku_detail.planner.ignore"), ignore_report_sku_operation_plan_path(@sku.sku_code, @plan, locale: params[:locale].presence),
                      method: :patch, class: "button button-secondary",
                      form: { data: { turbo_confirm: t("reports.sku_detail.planner.ignore_confirm") } } %>
      <% end %>
      <% if @plan.conversation %>
        <%= link_to ai_conversation_path(@plan.conversation, locale: params[:locale].presence), class: "button" do %>
          <i class="bi bi-chat-square-text" aria-hidden="true"></i>
          <%= t("reports.sku_detail.planner.view_conversation") %>
        <% end %>
      <% end %>
      <%= link_to report_sku_path(@sku.sku_code, tab: "ai_inventory_health", locale: params[:locale].presence), class: "button button-secondary" do %>
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <%= t("reports.sku_detail.ai_diagnosis_details.back") %>
      <% end %>
    </div>
  </header>

  <dl class="sku-plan-detail__facts">
    <div>
      <dt><%= t("reports.sku_detail.planner.plan_date") %></dt>
      <dd><time datetime="<%= @plan.plan_date.iso8601 %>"><%= @plan.plan_date.iso8601 %></time></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.target") %></dt>
      <dd><%= t("reports.sku_detail.planner.targets.#{@plan.target}") %></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.operation") %></dt>
      <dd><%= t("reports.sku_detail.planner.operations.#{@plan.operation}") %></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.status") %></dt>
      <dd><span class="status-pill <%= @plan.active? ? 'is-active' : 'is-muted' %>"><%= t("reports.sku_detail.planner.statuses.#{@plan.status}") %></span></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.planning_period") %></dt>
      <dd><%= @plan.period_start.iso8601 %> - <%= @plan.period_end.iso8601 %></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.execution_deadline") %></dt>
      <dd><%= @plan.execution_deadline.iso8601 %></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.execution_status") %></dt>
      <dd><%= t("reports.sku_detail.planner.execution_statuses.#{@plan.execution_status}") %></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.evaluation_status") %></dt>
      <dd><%= t("reports.sku_detail.planner.evaluation_statuses.#{@plan.evaluation_status}") %></dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.planner.referer") %></dt>
      <dd class="sku-plan-detail__references">
        <%= render "reports/sku_operation_plan_referers", plan: @plan, events_by_id: @sku_plan_referer_events, dom_id_prefix: "sku-plan-#{@plan.id}-detail-referer" %>
      </dd>
    </div>
    <div>
      <dt><%= t("reports.sku_detail.fields.created_at") %></dt>
      <dd><time datetime="<%= @plan.created_at.iso8601 %>"><%= display_time(@plan.created_at) %></time></dd>
    </div>
  </dl>

  <% if (evaluation = @plan.latest_evaluation) %>
    <section class="sku-plan-detail__message" aria-labelledby="sku-plan-evaluation-title">
      <h2 id="sku-plan-evaluation-title" class="section-title"><%= t("reports.sku_detail.planner.evaluation") %></h2>
      <p><%= t("reports.sku_detail.planner.evaluation_meta", effectiveness: t("reports.sku_detail.planner.effectivenesses.#{evaluation.effectiveness}"), confidence: t("reports.sku_detail.planner.confidences.#{evaluation.confidence}")) %></p>
      <p><%= evaluation.summary %></p>
    </section>
  <% end %>

  <% if @plan.evaluations.size > 1 %>
    <section class="sku-plan-detail__message" aria-labelledby="sku-plan-evaluation-history-title">
      <h2 id="sku-plan-evaluation-history-title" class="section-title"><%= t("reports.sku_detail.planner.evaluation_history") %></h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th><%= t("reports.sku_detail.planner.observation_period") %></th><th><%= t("reports.sku_detail.planner.evaluation_status") %></th><th><%= t("reports.sku_detail.planner.effectiveness") %></th><th><%= t("reports.sku_detail.planner.confidence") %></th><th><%= t("reports.sku_detail.planner.evaluated_at") %></th></tr></thead>
          <tbody>
            <% @plan.evaluations.latest_first.each do |item| %>
              <tr>
                <td><%= item.observation_from.iso8601 %> - <%= item.observation_to.iso8601 %></td>
                <td><%= t("reports.sku_detail.planner.evaluation_run_statuses.#{item.status}") %></td>
                <td><%= item.effectiveness.present? ? t("reports.sku_detail.planner.effectivenesses.#{item.effectiveness}") : report_value(nil) %></td>
                <td><%= item.confidence.present? ? t("reports.sku_detail.planner.confidences.#{item.confidence}") : report_value(nil) %></td>
                <td><%= display_time(item.evaluated_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @cycle_history_revisions.size > 1 %>
    <section class="sku-plan-detail__message" aria-labelledby="sku-plan-cycle-history-title">
      <h2 id="sku-plan-cycle-history-title" class="section-title"><%= t("reports.sku_detail.planner.cycle_history") %></h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th><%= t("reports.sku_detail.planner.cycle_revision") %></th>
              <th><%= t("reports.sku_detail.planner.cycle_status") %></th>
              <th><%= t("reports.sku_detail.planner.plan_title_label") %></th>
              <th><%= t("reports.sku_detail.planner.target") %></th>
              <th><%= t("reports.sku_detail.planner.operation") %></th>
              <th><%= t("reports.sku_detail.planner.execution_status") %></th>
              <th><%= t("reports.sku_detail.planner.evaluation_status") %></th>
            </tr>
          </thead>
          <tbody>
            <% @cycle_history.each do |item| %>
              <tr>
                <td>
                  <% if item.planning_cycle %>
                    <%= t("reports.sku_detail.planner.cycle_revision_value", revision: item.planning_cycle.revision) %>
                  <% else %>
                    <%= report_value(nil) %>
                  <% end %>
                </td>
                <td>
                  <% if item.planning_cycle %>
                    <%= t("reports.sku_detail.planner.cycle_statuses.#{item.planning_cycle.status}") %>
                  <% else %>
                    <%= report_value(nil) %>
                  <% end %>
                </td>
                <td><%= link_to t("reports.sku_detail.planner.plan_title", id: item.id), report_sku_operation_plan_path(@sku.sku_code, item, locale: params[:locale].presence) %></td>
                <td><%= t("reports.sku_detail.planner.targets.#{item.target}") %></td>
                <td><%= t("reports.sku_detail.planner.operations.#{item.operation}") %></td>
                <td><%= t("reports.sku_detail.planner.execution_statuses.#{item.execution_status}") %></td>
                <td><%= t("reports.sku_detail.planner.evaluation_statuses.#{item.evaluation_status}") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="sku-plan-detail__message" aria-labelledby="sku-plan-message-title">
    <h2 id="sku-plan-message-title" class="section-title"><%= t("reports.sku_detail.planner.message") %></h2>
    <div class="sku-plan-detail__body" data-controller="markdown">
      <pre data-markdown-target="source"><%= @plan.message %></pre>
      <article class="gbrain-markdown" data-markdown-target="output" hidden></article>
    </div>
  </section>
  <%= render "reports/sku_operation_plan_details", plan: @plan %>
</div>
<%= render "reports/sku_operation_plan_referer_dialogs", plan: @plan, events_by_id: @sku_plan_referer_events, dom_id_prefix: "sku-plan-#{@plan.id}-detail-referer" %>
