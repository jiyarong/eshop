<%= turbo_frame_tag "erp_modal" do %>
  <div class="erp-modal-backdrop" data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <section class="erp-modal" role="dialog" aria-modal="true" aria-labelledby="sku-operation-record-modal-title">
      <div class="erp-modal__header">
        <div>
          <h2 id="sku-operation-record-modal-title"><%= t("reports.sku_detail.operation_record.edit_title") %></h2>
          <p class="erp-modal__subtitle"><%= @sku.sku_code %></p>
        </div>
        <button class="icon-button" type="button" aria-label="<%= t("common.actions.close") %>" data-action="modal#close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>
      <%= render "sku_operation_action_form",
                 operation_action: @operation_action,
                 action_url: report_sku_operation_action_path(@sku.sku_code, @operation_action, request.query_parameters.slice(:locale)),
                 form_method: :patch %>
    </section>
  </div>
<% end %>
