<% pagination = report[:pagination] %>
<% page_param = local_assigns.fetch(:page_param, :page).to_sym %>
<% path_builder = local_assigns.fetch(:path_builder, ->(params) { reports_supply_orders_path(params) }) %>
<% turbo_frame = local_assigns.fetch(:turbo_frame, "supply_order_report_results") %>
<% query = request.query_parameters.symbolize_keys.except(page_param, :page, :jump_page, :current_page) %>
<div class="inventory-pagination-bar">
  <div class="pagination-meta">
    <div class="inventory-pagination-bar__summary"><%= t("supply_order_reports.pagination.summary", from: (pagination[:page] - 1) * pagination[:per_page] + 1, to: [pagination[:page] * pagination[:per_page], pagination[:total_count]].min, total: pagination[:total_count]) %></div>
    <span class="pagination-chip"><%= t("supply_order_reports.pagination.page", page: pagination[:page], pages: pagination[:total_pages]) %></span>
  </div>
  <div class="pagination-shell">
    <nav class="pagination-nav" aria-label="<%= t("supply_order_reports.pagination.aria_label") %>">
      <% if pagination[:page] > 1 %>
        <%= link_to "‹", path_builder.call(query.merge(page_param => pagination[:page] - 1)), class: "pg-btn pg-btn-nav", data: { turbo_frame: turbo_frame }.compact, aria: { label: t("supply_order_reports.pagination.previous") } %>
      <% else %><span class="pg-btn pg-btn-nav" aria-disabled="true">‹</span><% end %>
      <% inventory_pagination_items(pagination[:page], pagination[:total_pages]).each do |item| %>
        <% if item.is_a?(Symbol) %><span class="pg-ell" aria-hidden="true">…</span>
        <% elsif item == pagination[:page] %><span class="pg-btn on"><%= item %></span>
        <% else %><%= link_to item, path_builder.call(query.merge(page_param => item)), class: "pg-btn", data: { turbo_frame: turbo_frame }.compact %><% end %>
      <% end %>
      <% if pagination[:page] < pagination[:total_pages] %>
        <%= link_to "›", path_builder.call(query.merge(page_param => pagination[:page] + 1)), class: "pg-btn pg-btn-nav", data: { turbo_frame: turbo_frame }.compact, aria: { label: t("supply_order_reports.pagination.next") } %>
      <% else %><span class="pg-btn pg-btn-nav" aria-disabled="true">›</span><% end %>
    </nav>
    <span class="pagination-divider" aria-hidden="true"></span>
    <%= form_with url: path_builder.call({}), method: :get, local: true, class: "pagination-jump", data: { turbo_frame: turbo_frame }.compact do %>
      <% query.each do |key, value| %>
        <% Array(value).each do |item| %><%= hidden_field_tag(value.is_a?(Array) ? "#{key}[]" : key, item) %><% end %>
      <% end %>
      <%= hidden_field_tag :current_page, pagination[:page] %>
      <span class="pagination-jump-label"><%= t("supply_order_reports.pagination.jump_label") %></span>
      <%= text_field_tag :jump_page, pagination[:page], class: "pagination-jump-input", inputmode: "numeric", pattern: "[0-9]*" %>
      <%= submit_tag t("supply_order_reports.pagination.jump_action"), class: "pg-btn pg-btn-jump" %>
    <% end %>
  </div>
</div>
