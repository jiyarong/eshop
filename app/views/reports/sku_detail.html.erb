<% unless @sku_detail_drawer %>
  <% content_for :page_heading, t("reports.sku_detail.title") %>

  <div class="resource-header">
    <div>
      <p class="resource-eyebrow"><%= t("reports.sku_detail.title") %></p>
      <h1 class="page-title"><%= @sku.sku_code %></h1>
    </div>
    <div class="resource-actions">
      <%= link_to t("reports.sku_detail.actions.back_to_list"), operator_skus_path,
                  class: "button button-secondary",
                  data: { controller: "history-navigation", action: "history-navigation#back" } %>
      <%= link_to t("reports.sku_detail.actions.edit_profile"), erp_edit_sku_path(@sku), class: "button" %>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "erp_modal" %>

<section class="panel sku-detail-hero">
  <div class="sku-detail-identity">
    <span class="status-pill <%= @sku.is_active ? "is-active" : "is-muted" %>">
      <%= t(@sku.is_active ? "reports.sku_detail.status.active" : "reports.sku_detail.status.inactive") %>
    </span>
    <h2><%= report_value(@sku.product_name) %></h2>
    <p><%= report_value(@sku.product_name_ru) %></p>
    <div class="sku-detail-marketing-state">
      <%= render "erp/sku_marketing_states/marketing_state",
                 sku: @sku,
                 locale_params: request.query_parameters.slice(:locale),
                 return_to: request.fullpath %>
    </div>
  </div>

  <div class="summary-grid sku-detail-performance-grid">
    <% performance_cards = [
      [t("operator_skus.columns.sales"), :sales, nil, :number],
      [t("operator_skus.columns.revenue"), :profit, :revenue, :currency],
      [t("operator_skus.columns.profit"), :profit, :after_tax, :currency],
      [t("operator_skus.columns.margin"), :profit, :margin_pct, :percentage],
      [t("operator_skus.columns.ads"), :profit, :ads, :currency]
    ] %>
    <% performance_cards.each do |label, group, metric_key, type| %>
      <div class="weekly-profit-summary-card sku-detail-performance-card">
        <div class="summary-label"><%= label %></div>
        <div class="operator-sku-profit">
          <% %i[days_7 days_30].each do |period_key| %>
            <% metric = group == :sales ? @operator_metrics.dig(:sales, period_key) : @operator_metrics.dig(:profit, period_key, metric_key) %>
            <div class="operator-sku-period">
              <span class="operator-sku-period__value"><%= t("operator_skus.values.#{period_key}") %> <strong><%= operator_sku_metric_value(metric[:value], type: type) %></strong></span>
              <span class="operator-sku-comparison <%= operator_sku_comparison_class(metric[:comparison]) %>"><%= operator_sku_comparison_text(metric[:comparison]) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<nav class="erp-tabs erp-tabs--underline sku-detail-tabs"
     aria-label="<%= t("reports.sku_detail.tabs.aria_label") %>"
     data-controller="sku-detail-tabs"
     data-action="turbo:frame-load@window->sku-detail-tabs#sync">
  <% %w[operation inventory ads ai_inventory_health trend basic].each do |tab| %>
    <%= link_to t("reports.sku_detail.tabs.#{tab}"),
                sku_detail_tab_path(tab),
                class: "erp-tabs__link sku-detail-tabs__link",
                data: (@sku_detail_drawer ? {
                  turbo_frame: "sku_detail_tab",
                  sku_detail_tabs_target: "link",
                  action: "sku-detail-tabs#select"
                } : {}),
                aria: (@active_tab == tab ? { current: "page" } : nil) %>
  <% end %>
</nav>

<%= render "reports/sku_detail_tab_frame" %>
