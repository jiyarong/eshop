<aside class="pallet-workbench__editor" aria-label="<%= t('pallet_workbench.current_pallet') %>">
  <section class="panel">
    <div class="pallet-workbench__section-heading"><div><span class="pallet-workbench__eyebrow"><%= t("pallet_workbench.step_pack") %></span><h2><%= t("pallet_workbench.current_pallet") %></h2></div><span class="pallet-workbench__badge"><%= t("pallet_workbench.local_draft") %></span></div>
    <div class="field pallet-workbench__mode"><label for="pallet-packing-mode"><%= t("pallet_workbench.packing_mode") %></label><select id="pallet-packing-mode" data-pallet-workbench-target="mode" data-action="change->pallet-workbench#changeMode"><option value="single"><%= t("pallet_workbench.single_mode") %></option><option value="multiple"><%= t("pallet_workbench.multiple_mode") %></option></select></div>
    <button type="button" class="button pallet-workbench__recommend" data-pallet-workbench-target="recommendButton" data-action="pallet-workbench#recommendOne"><%= t("pallet_workbench.recommend_one") %></button>
    <p class="pallet-workbench__hint"><%= t("pallet_workbench.recommend_hint") %></p>
    <div class="pallet-workbench__summary" aria-live="polite">
      <div><strong data-pallet-workbench-target="skuCount">0</strong><span><%= t("pallet_workbench.summary.skus") %></span></div>
      <div><strong data-pallet-workbench-target="boxCount">0</strong><span><%= t("pallet_workbench.summary.boxes") %></span></div>
      <div><strong data-pallet-workbench-target="unitCount">0</strong><span><%= t("pallet_workbench.summary.units") %></span></div>
      <div><strong data-pallet-workbench-target="weightCount">0</strong><span><%= t("pallet_workbench.summary.weight") %></span></div>
    </div>
    <div class="pallet-workbench__save-bar">
      <div class="pallet-workbench__feedback">
        <span class="pallet-workbench__eyebrow"><%= t("pallet_workbench.step_save") %></span>
        <p role="status" aria-live="polite" data-pallet-workbench-target="status"></p>
        <div class="pallet-workbench__capacity" data-pallet-workbench-target="capacity" hidden>
          <label><span><%= t("pallet_workbench.height_usage") %></span><strong data-pallet-workbench-target="heightLabel"></strong><meter min="0" max="220" value="0" data-pallet-workbench-target="heightMeter"></meter></label>
          <label><span><%= t("pallet_workbench.weight_usage") %></span><strong data-pallet-workbench-target="weightLabel"></strong><meter min="0" max="800" value="0" data-pallet-workbench-target="weightMeter"></meter></label>
          <a href="#pallet-workbench-result"><%= t("pallet_workbench.view_layout") %></a>
        </div>
      </div>
      <div class="pallet-workbench__actions"><button type="button" class="button button-secondary" data-pallet-workbench-target="calculateButton" data-action="pallet-workbench#preview" disabled><%= t("pallet_workbench.recalculate") %></button><button type="button" class="button" data-pallet-workbench-target="saveButton" data-action="pallet-workbench#save" disabled><%= t("pallet_workbench.save_draft") %></button></div>
    </div>
    <div class="pallet-workbench__section-heading"><h3><%= t("pallet_workbench.manifest") %></h3><button type="button" class="pallet-workbench__text-button" data-pallet-workbench-target="undoButton" data-action="pallet-workbench#undo" hidden><%= t("pallet_workbench.undo") %></button></div>
    <div class="pallet-workbench__empty" data-pallet-workbench-target="emptyManifest"><strong><%= t("pallet_workbench.empty_manifest") %></strong><p><%= t("pallet_workbench.empty_manifest_hint") %></p></div>
    <div data-pallet-workbench-target="manifest" class="pallet-workbench__manifest"></div>
    <p class="pallet-workbench__hint"><%= t("pallet_workbench.autosave_hint") %></p>
    <details class="pallet-workbench__advanced"><summary><%= t("pallet_calculator.parameters") %></summary><div class="pallet-workbench__packaging">
      <% defaults = @plan ? PalletPacking::Rules.defaults("ozon_fbo").merge(@plan.settings.symbolize_keys) : PalletPacking::Rules.defaults("ozon_fbo") %>
      <% %i[height weight overhang tare route_rate].each do |key| %><div class="field"><label for="workbench-setting-<%= key %>"><%= t("pallet_calculator.fields.#{key}") %></label><input type="number" id="workbench-setting-<%= key %>" data-setting="<%= key %>" value="<%= defaults[key] %>" min="0" step="any" data-action="change->pallet-workbench#invalidate"></div><% end %>
    </div></details>

  </section>
  <details class="panel" data-pallet-workbench-target="allocationPanel" hidden>
    <summary><%= t("pallet_workbench.manual_allocation") %></summary><p class="pallet-workbench__hint"><%= t("pallet_workbench.allocation_hint") %></p>
    <div data-pallet-workbench-target="allocationRows" class="pallet-workbench__allocations"></div>
    <div class="pallet-workbench__actions"><button type="button" class="button button-secondary" data-action="pallet-workbench#addPallet"><%= t("pallet_workbench.add_pallet") %></button><button type="button" class="button" data-action="pallet-workbench#validateAllocation"><%= t("pallet_workbench.validate") %></button></div>
  </details>
  <div id="pallet-workbench-result" data-pallet-workbench-target="results" aria-live="polite"></div>
</aside>
<template data-pallet-workbench-target="itemTemplate"><article class="pallet-workbench__item" data-item>
  <div class="pallet-workbench__section-heading"><div><strong data-code></strong><small data-name class="pallet-workbench__product"></small></div><button type="button" class="pallet-workbench__text-button" data-action="pallet-workbench#removeItem"><%= t("pallet_workbench.remove") %></button></div>
  <div class="pallet-workbench__quantity-row"><label data-quantity-label><%= t("pallet_calculator.fields.quantity") %></label><div class="pallet-workbench__stepper"><button type="button" data-delta="-1" data-action="pallet-workbench#stepQuantity" aria-label="<%= t('pallet_workbench.decrease') %>">−</button><input type="number" data-field="quantity" min="1" step="1" data-action="input->pallet-workbench#changeItem"><button type="button" data-delta="1" data-action="pallet-workbench#stepQuantity" aria-label="<%= t('pallet_workbench.increase') %>">+</button></div></div>
  <p data-stock class="pallet-workbench__hint"></p>
  <details><summary><%= t("pallet_workbench.packaging_details") %></summary><div class="pallet-workbench__packaging">
    <% %w[length width height weight pcs unit_volume_l].each do |key| %><label class="field"><%= t("pallet_calculator.fields.#{key}") %><input type="number" data-field="<%= key %>" min="<%= %w[weight unit_volume_l].include?(key) ? 0.001 : 1 %>" step="<%= key == 'pcs' ? 1 : 'any' %>" data-action="change->pallet-workbench#changeItem"></label><% end %>
    <label class="checkbox-option"><input type="checkbox" data-field="rotatable" data-action="change->pallet-workbench#changeItem"><%= t("pallet_calculator.fields.rotatable") %></label>
  </div></details>
</article></template>
<template data-pallet-workbench-target="allocationTemplate"><fieldset><legend data-title></legend><div data-items></div><button type="button" class="button button-secondary" data-action="pallet-workbench#removePallet"><%= t("pallet_workbench.remove") %></button></fieldset></template>
<dialog data-pallet-workbench-target="autoDialog" class="pallet-workbench__dialog" aria-labelledby="pallet-auto-title">
  <h2 id="pallet-auto-title"><%= t("pallet_workbench.auto_select") %></h2><p><%= t("pallet_workbench.auto_hint") %></p>
  <label class="checkbox-option"><input type="checkbox" data-pallet-workbench-target="mySkus"><%= t("pallet_workbench.my_skus") %></label>
  <div class="field"><label for="pallet-auto-shortage"><%= t("pallet_workbench.shortage_gt") %></label><input id="pallet-auto-shortage" type="number" min="0" value="<%= params[:shortage_gt].presence || 0 %>" data-pallet-workbench-target="threshold"></div>
  <p role="status" data-pallet-workbench-target="autoStatus"></p>
  <div class="pallet-workbench__actions"><button type="button" class="button" data-pallet-workbench-target="autoPreviewButton" data-action="pallet-workbench#autoSelect"><%= t("pallet_workbench.preview_selection") %></button><button type="button" class="button button-secondary" data-pallet-workbench-target="autoApplyButton" data-action="pallet-workbench#applyAuto" disabled><%= t("pallet_workbench.apply_selection") %></button><button type="button" class="button button-secondary" data-action="pallet-workbench#closeAuto"><%= t("pallet_workbench.close") %></button></div>
</dialog>
