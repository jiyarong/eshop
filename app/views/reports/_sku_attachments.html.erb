<%= render "shared/attachments",
           attachments: @attachments,
           dom_id_prefix: "sku-#{@sku.id}-attachments",
           can_manage: can?(:manage_skus),
           attach_type_options: Ec::Attachment::SKU_ATTACH_TYPES.map { |type| [t("reports.sku_detail.attachments.attach_types.#{type}"), type] },
           upload_path: report_sku_attachments_path(@sku.sku_code, request.query_parameters.slice(:locale)),
           download_path_for: ->(attachment) { report_sku_attachment_path(@sku.sku_code, attachment, request.query_parameters.slice(:locale)) },
           preview_path_for: ->(attachment) { preview_report_sku_attachment_path(@sku.sku_code, attachment, request.query_parameters.slice(:locale)) },
           edit_path_for: ->(attachment) { edit_report_sku_attachment_path(@sku.sku_code, attachment, request.query_parameters.slice(:locale)) },
           delete_path_for: ->(attachment) { report_sku_attachment_path(@sku.sku_code, attachment, request.query_parameters.slice(:locale)) } %>
