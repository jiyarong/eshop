<% pa = "reports.sku_detail.profit_analysis" %>
<section class="panel sku-profit-analysis">
  <h2 class="section-title"><%= t("#{pa}.title") %></h2>
  <form action="<%= report_sku_path(@sku.sku_code) %>" method="get" class="report-form sku-operation-filter" <% if @sku_detail_drawer %>data-turbo-frame="<%= @sku_detail_tab_frame_id %>"<% end %>>
    <input type="hidden" name="tab" value="profit"><% if params[:locale].present? %><input type="hidden" name="locale" value="<%= params[:locale] %>"><% end %>
    <%= render "shared/time_range_selector", id: "sku-profit-time-range", from_date: @profit_from_date, to_date: @profit_to_date, from_name: "profit_from_date", to_name: "profit_to_date", submit_on_apply: true %>
  </form>
  <% if @operation_profit_error.present? %><div class="empty-state"><%= t("#{pa}.load_error") %></div>
  <% elsif @profit_analysis.present? %>
    <% overview_metrics = %i[net_sales revenue average_price commission_fee payment_fee delivery_fee return_delivery_fee storage_fee dispatch_fee packing_fee defect_fee crossdock_fee other_platform_fee ads ad_ratio_pct goods_cost cost_ratio_pct pre_tax tax after_tax profit_margin_pct average_profit_per_order annualized_return_pct annualized_net_profit_cny] %>
    <section class="sku-profit-analysis__section"><h3><%= t("#{pa}.overview") %></h3><div class="table-scroll"><table class="sku-profit-matrix"><thead><tr><th><%= t("#{pa}.metric") %></th>
      <% @profit_analysis[:periods].each do |period| %><th><div class="sku-profit-period__heading"><span class="sku-profit-period__key"><%= period[:key] %></span><% if period[:key] == "P0" %><span class="sku-profit-period__selected"><%= t("#{pa}.selected_period") %></span><% end %></div><div class="sku-profit-period__dates"><%= period[:from_date] %> ~ <%= period[:to_date] %></div></th><% end %>
    </tr></thead><tbody><% overview_metrics.each do |metric| %><tr><th><%= t("#{pa}.metrics.#{metric}") %></th><% @profit_analysis[:periods].each_with_index do |period, index| %><td><div class="weekly-profit-table-value"><%= sku_profit_analysis_value(period[:sku_row], metric) %></div><% if index.positive? %><% comparison = sku_profit_period_comparison(period[:sku_row], @profit_analysis[:periods][index - 1][:sku_row], metric) %><% if comparison.present? %><div class="weekly-profit-table-comparison <%= sku_operation_comparison_class(comparison) %>"><%= sku_operation_comparison_label(comparison) %></div><% end %><% end %></td><% end %></tr><% end %></tbody></table></div></section>
    <section class="sku-profit-analysis__section sku-profit-analysis__trend-toggle" data-controller="profit-trend-toggle" data-profit-trend-toggle-show-label-value="<%= t("#{pa}.show_eight_week_trends") %>" data-profit-trend-toggle-hide-label-value="<%= t("#{pa}.hide_eight_week_trends") %>">
      <button type="button" class="button sku-profit-analysis__trend-button" aria-expanded="false" data-profit-trend-toggle-target="button" data-action="profit-trend-toggle#toggle"><%= t("#{pa}.show_eight_week_trends") %></button>
      <div data-profit-trend-toggle-target="content" hidden><%= turbo_frame_tag "sku_profit_trend", src: report_sku_profit_trend_path(@sku.sku_code, profit_to_date: @profit_to_date, locale: params[:locale]), loading: :lazy do %><div class="empty-state"><%= t("#{pa}.loading") %></div><% end %></div>
    </section>
    <section class="sku-profit-analysis__section" data-controller="profit-period-filter"><div class="sku-profit-analysis__store-heading"><h3><%= t("#{pa}.store_detail") %></h3><fieldset class="sku-profit-period-filter"><legend><%= t("#{pa}.period_filter") %></legend><div class="sku-profit-period-filter__options"><% @profit_analysis[:periods].each do |period| %><label><input type="checkbox" value="<%= period[:key] %>" checked data-profit-period-filter-target="checkbox" data-action="profit-period-filter#update"><span><%= period[:key] %></span></label><% end %></div></fieldset></div><div class="table-scroll table-scroll--horizontal table-scroll--contained"><table class="sku-profit-store-table"><thead><tr>
      <% %i[store period net_sales revenue average_price commission_fee payment_fee delivery_fee return_delivery_fee storage_fee dispatch_fee packing_fee defect_fee crossdock_fee other_platform_fee ads ad_ratio_pct goods_cost cost_ratio_pct pre_tax tax after_tax profit_margin_pct average_profit_per_order annualized_return_pct annualized_net_profit_cny].each do |metric| %><th><%= t("#{pa}.metrics.#{metric}") %></th><% end %>
    </tr></thead>
      <% if @profit_analysis[:store_groups].empty? %><tbody><tr><td colspan="26" class="empty-state"><%= t("#{pa}.no_stores") %></td></tr></tbody><% end %>
      <% @profit_analysis[:store_groups].each do |group| %><tbody data-profit-period-filter-target="group"><% @profit_analysis[:periods].each_with_index do |period, index| %><tr data-profit-period-filter-target="row" data-period="<%= period[:key] %>">
        <% if index.zero? %><th rowspan="4" data-profit-period-filter-store-cell><%= group[:platform].to_s.upcase %> / <%= group[:shop] %></th><% end %>
        <td><strong><%= period[:key] %></strong><small><%= period[:from_date] %> - <%= period[:to_date] %></small></td><% row = group[:rows_by_period][period[:key]] || {} %>
        <% %i[net_sales revenue average_price commission_fee payment_fee delivery_fee return_delivery_fee storage_fee dispatch_fee packing_fee defect_fee crossdock_fee other_platform_fee ads ad_ratio_pct goods_cost cost_ratio_pct pre_tax tax after_tax profit_margin_pct average_profit_per_order annualized_return_pct annualized_net_profit_cny].each do |metric| %><td><div class="weekly-profit-table-value"><%= sku_profit_analysis_value(row, metric) %></div><% if index.positive? %><% previous_row = group[:rows_by_period][@profit_analysis[:periods][index - 1][:key]] || {} %><% comparison = sku_profit_period_comparison(row, previous_row, metric) %><% if comparison.present? %><div class="weekly-profit-table-comparison <%= sku_operation_comparison_class(comparison) %>"><%= sku_operation_comparison_label(comparison) %></div><% end %><% end %></td><% end %>
      </tr><% end %></tbody><% end %>
    </table></div></section>
    <% store_refs = @profit_analysis[:store_groups].map { |group| group[:store_ref] } %>
    <% if store_refs.any? %><section class="sku-profit-analysis__section"><%= turbo_frame_tag "sku_store_profit_trend", src: report_sku_profit_trend_path(@sku.sku_code, view: "store", profit_to_date: @profit_to_date, store_refs: store_refs, locale: params[:locale]), loading: :lazy do %><div class="empty-state"><%= t("#{pa}.loading") %></div><% end %></section><% end %>
  <% end %>
</section>
