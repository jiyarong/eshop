<% profit_contexts = profit_prediction_contexts(@profit_version) %>
<% profit_version_new = @profit_version.new_record? %>
<% profit_version_readonly = @profit_version.persisted? && @profit_version.archived? %>
<% save_url = profit_version_new ? report_sku_profit_versions_path(@sku.sku_code) : report_sku_profit_version_path(@sku.sku_code, @profit_version) %>
<% warning_fields = %i[fbo_delivery_cny storage_cny acquiring_rate advertising_rate damage_rate misc_cny other_cny] %>
<% profit_messages = {
