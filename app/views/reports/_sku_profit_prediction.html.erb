  calculation_failed: t("reports.profit_prediction.calculation_failed"),
  dirty: t("reports.profit_prediction.status.dirty", count: "__COUNT__"),
  context_count: t("reports.profit_prediction.context_count", count: "__COUNT__"),
  filtered_context_count: t("reports.profit_prediction.filtered_context_count"),
  measuring: t("reports.profit_prediction.status.measuring"),
  saved: t("reports.profit_prediction.status.saved"),
  save_failed: t("reports.profit_prediction.status.save_failed"),
  confirm_leave: t("reports.profit_prediction.confirm_leave"),
  statuses: {
    valid: t("reports.profit_prediction.calculation_statuses.valid"),
    incomplete: t("reports.profit_prediction.calculation_statuses.incomplete"),
    pending: t("reports.profit_prediction.calculation_statuses.pending")
