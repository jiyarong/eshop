        result_with_products: t("reports.profit_prediction.sources.official_commission.result_with_products", rate: "__RATE__", count: "__COUNT__"),
        apply: t("reports.profit_prediction.sources.official_commission.apply"),
        meta: t("reports.profit_prediction.sources.official_commission.meta", resolved: "__RESOLVED__", total: "__TOTAL__", field: "__FIELD__", synced_at: "__SYNCED_AT__")
      },
      cross_dock_tariffs: {
        action: t("reports.profit_prediction.sources.cross_dock_tariffs.action"),
