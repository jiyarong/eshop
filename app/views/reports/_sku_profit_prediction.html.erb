<section
  class="profit-prediction-workbench <%= "is-calculating" unless profit_version_readonly %>"
  data-controller="profit-prediction"
  data-profit-prediction-url-value="<%= preview_report_sku_profit_path(@sku.sku_code) %>"
  data-profit-prediction-tariff-url-value="<%= reports_ozon_logistics_tariffs_path(format: :json) %>"
  data-profit-prediction-cross-dock-tariff-url-value="<%= reports_ozon_cross_dock_tariffs_path(format: :json) %>"
  data-profit-prediction-wb-logistics-tariff-url-value="<%= reports_wb_logistics_tariffs_path(format: :json) %>"
  data-profit-prediction-actual-logistics-url-value="<%= report_sku_actual_logistics_path(@sku.sku_code, format: :json) %>"
  data-profit-prediction-actual-return-rate-url-value="<%= report_sku_actual_return_rate_path(@sku.sku_code, format: :json) %>"
  data-profit-prediction-actual-storage-url-value="<%= report_sku_actual_storage_path(@sku.sku_code, format: :json) %>"
  data-profit-prediction-actual-selling-price-url-value="<%= report_sku_actual_selling_price_path(@sku.sku_code, format: :json) %>"
  data-profit-prediction-actual-advertising-url-value="<%= report_sku_actual_advertising_path(@sku.sku_code, format: :json) %>"
  data-profit-prediction-official-commission-url-value="<%= report_sku_official_commission_rate_path(@sku.sku_code, format: :json) %>"
  data-profit-prediction-messages-value="<%= json_escape(profit_messages.to_json) %>"
  data-profit-prediction-new-record-value="<%= profit_version_new %>"
  data-profit-prediction-status-value="<%= @profit_version.status %>"
  data-profit-prediction-readonly-value="<%= profit_version_readonly %>"
  data-save-url="<%= save_url %>"
  data-save-method="<%= profit_version_new ? "POST" : "PATCH" %>"
  data-lock-version="<%= @profit_version.lock_version %>"
>
  <header class="profit-prediction-toolbar">
    <div class="profit-prediction-toolbar__main">
      <div class="profit-prediction-toolbar__identity">
        <h2 class="section-title"><%= t("reports.profit_prediction.title") %></h2>
        <label class="profit-prediction-version-switcher">
          <%= select_tag :profit_version_id,
            options_for_select(
              @profit_versions.map { |version| ["#{version.name} · #{t("reports.profit_prediction.version_statuses.#{version.status}")}", version.id] },
              @profit_version.id
            ),
            include_blank: profit_version_new ? t("reports.profit_prediction.unsaved_version") : nil,
            disabled: @profit_versions.empty?,
            class: "input",
            data: {
              profit_prediction_target: "navigationControl",
              action: "change->profit-prediction#changeVersion"
            } %>
        </label>
        <div class="profit-prediction-toolbar__statuses">
          <span class="profit-prediction-mode-status" data-profit-prediction-target="modeStatus" aria-live="polite">
            <%= profit_version_new ? t("reports.profit_prediction.status.measuring") : t("reports.profit_prediction.status.saved") %>
          </span>
        </div>
      </div>

      <div class="profit-prediction-toolbar__actions">
        <div class="profit-prediction-toolbar__version-actions">
          <% if @profit_version.persisted? %>
            <%= link_to report_sku_path(@sku.sku_code, tab: "profit_prediction", copy_version_id: @profit_version.id), class: "btn btn-ghost btn-sm" do %>
              <i class="bi bi-copy" aria-hidden="true"></i>
              <%= t("reports.profit_prediction.actions.copy") %>
            <% end %>
          <% end %>
          <%= link_to report_sku_path(@sku.sku_code, tab: "profit_prediction", new_profit_version: 1), class: "btn btn-ghost btn-sm" do %>
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            <%= t("reports.profit_prediction.actions.new") %>
          <% end %>
        </div>
        <div class="profit-prediction-toolbar__calculation-actions">
          <% unless profit_version_readonly %>
            <button type="button" class="btn btn-primary btn-sm" data-profit-prediction-target="saveButton" data-action="profit-prediction#save">
              <i class="bi bi-floppy" aria-hidden="true"></i>
              <%= t("reports.profit_prediction.actions.save_calculation") %>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <%= hidden_field_tag :profit_version_name, @profit_version.name,
      data: { profit_prediction_target: "versionInput", version_field: "name" } %>
    <%= hidden_field_tag :profit_version_effective_from, @profit_version.effective_from,
      data: { profit_prediction_target: "versionInput", version_field: "effective_from" } %>
    <%= hidden_field_tag :profit_version_effective_to, @profit_version.effective_to,
      data: { profit_prediction_target: "versionInput", version_field: "effective_to" } %>
  </header>

  <% if @sku.dimension.blank? %>
    <div class="profit-prediction-alert" role="alert">
      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
      <%= t("reports.profit_prediction.dimension_missing") %>
    </div>
  <% end %>

  <div class="profit-prediction-table-note">
    <nav class="profit-prediction-platform-tabs" aria-label="<%= t("reports.profit_prediction.platform_tabs.label") %>">
      <% [["", "all"], ["wb", "wb"], ["ozon", "ozon"]].each_with_index do |(value, key), index| %>
        <button
          type="button"
          class="profit-prediction-platform-tab<%= " is-active" if index.zero? %>"
          data-profit-prediction-target="platformFilter"
          data-platform-value="<%= value %>"
          aria-selected="<%= index.zero? %>"
          role="tab"
          data-action="click->profit-prediction#platformFilterChanged"
        ><%= t("reports.profit_prediction.platform_tabs.#{key}") %></button>
      <% end %>
    </nav>
    <span data-profit-prediction-target="contextCount"><%= t("reports.profit_prediction.context_count", count: profit_contexts.size) %></span>
  </div>

  <section class="table-list-card profit-prediction-table-card">
    <%= table_viewport(
      class_name: "table-list-viewport",
      sticky_header: true,
      sticky_columns: SkuProfitPredictionHelper::PROFIT_IDENTITY_COLUMNS.size + 1
    ) do %>
      <table class="prod-tbl profit-prediction-table">
        <thead>
          <tr class="profit-prediction-table__groups">
            <th colspan="<%= SkuProfitPredictionHelper::PROFIT_IDENTITY_COLUMNS.size + 1 %>"><%= t("reports.profit_prediction.groups.context") %></th>
            <% profit_prediction_table_groups.each do |group, columns| %>
              <th colspan="<%= columns.size %>" data-platform-group="<%= group %>"><%= t("reports.profit_prediction.groups.#{group}") %></th>
            <% end %>
          </tr>
          <tr>
            <th class="profit-prediction-table__health-heading">
              <span class="sr-only"><%= t("reports.profit_prediction.result_fields.calculation_status") %></span>
            </th>
            <% SkuProfitPredictionHelper::PROFIT_IDENTITY_COLUMNS.each do |field| %>
              <th class="profit-prediction-table__identity-heading profit-prediction-table__identity-heading--<%= field %>"><%= t("reports.profit_prediction.identity_fields.#{field}") %></th>
            <% end %>
            <% profit_prediction_table_groups.each do |_group, columns| %>
              <% columns.each do |kind, field| %>
                <th class="num" data-field="<%= field %>" data-platforms="<%= profit_prediction_column_platforms(field).join(" ") %>" data-platform-column-group="<%= _group %>">
                  <%= t("reports.profit_prediction.#{kind == :result ? "result_fields" : "fields"}.#{field}") %>
                </th>
              <% end %>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% profit_contexts.each_with_index do |context, index| %>
            <% row_key = context.id || "new-#{index}" %>
            <tr
              class="profit-prediction-row"
              data-profit-prediction-target="row"
              data-row-key="<%= row_key %>"
              data-context-id="<%= context.id %>"
              data-platform="<%= context.platform %>"
              data-market="<%= context.market %>"
              data-delivery-mode="<%= context.delivery_mode %>"
              data-warehouse-region="<%= context.warehouse_region %>"
              data-company-type="<%= context.company_type %>"
              data-calculation-status="<%= context.calculation_status %>"
              data-context-label="<%= SkuProfitPredictionHelper::PROFIT_IDENTITY_COLUMNS.map { |field| profit_prediction_identity_value(context, field) }.join(" · ") %>"
              data-action="click->profit-prediction#selectRow keydown->profit-prediction#selectRowWithKeyboard"
              tabindex="0"
              aria-selected="false"
            >
              <td
                class="profit-prediction-table__health"
                data-row-status
                data-status="<%= context.calculation_status %>"
                title="<%= t("reports.profit_prediction.calculation_statuses.#{context.calculation_status}") %>"
              >
                <span class="sr-only" data-row-status-label><%= t("reports.profit_prediction.calculation_statuses.#{context.calculation_status}") %></span>
              </td>
              <% SkuProfitPredictionHelper::PROFIT_IDENTITY_COLUMNS.each do |field| %>
                <td class="profit-prediction-table__identity profit-prediction-table__identity--<%= field %>"><%= profit_prediction_identity_value(context, field) %></td>
              <% end %>
              <% profit_prediction_table_groups.each do |_group, columns| %>
                <% columns.each do |kind, field| %>
                  <% column_platforms = profit_prediction_column_platforms(field) %>
                  <% if kind == :input %>
                    <td class="num profit-prediction-table__input-cell" data-platforms="<%= column_platforms.join(" ") %>" data-platform-column-group="<%= _group %>">
                      <% if profit_prediction_input_applicable?(context, field) %>
                        <% input_editable = profit_prediction_input_editable?(context, field) %>
                        <% input_value = context.public_send(field) %>
                        <%= number_field_tag "profit_context_#{index}_#{field}", profit_prediction_input_value(input_value, field),
                          step: "any",
                          disabled: profit_version_readonly || !input_editable,
                          aria: { label: t("reports.profit_prediction.fields.#{field}") },
                          class: "profit-prediction-cell-input",
                          data: {
                            profit_prediction_target: "input",
                            field: field,
                            editable: input_editable,
                            source_value: profit_prediction_raw_value(input_value),
                            action: "input->profit-prediction#inputChanged"
                          } %>
                      <% else %>
                        <%= hidden_field_tag "profit_context_#{index}_#{field}", context.public_send(field),
                          disabled: profit_version_readonly,
                          data: { profit_prediction_target: "input", field: field, editable: false } %>
                        <span class="profit-prediction-table__not-applicable"><%= profit_prediction_not_applicable_label(context, field) %></span>
                      <% end %>
                    </td>
                  <% else %>
                    <% result_value = context.public_send(field) %>
                    <% result_class = if (field == :profit_cny || field == :margin) && result_value.present?
                      result_value.to_d.negative? ? "is-negative" : "is-positive"
                    end %>
                    <td class="num profit-prediction-table__result <%= result_class %>" data-result-field="<%= field %>" data-platforms="<%= column_platforms.join(" ") %>" data-platform-column-group="<%= _group %>">
                      <%= profit_prediction_result_value(context, field) %>
                    </td>
                  <% end %>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <section class="profit-prediction-process" aria-labelledby="profit-prediction-process-title">
    <header class="profit-prediction-process__header">
      <nav
        class="profit-prediction-process__scenario-tabs"
        role="tablist"
        aria-label="<%= t("reports.profit_prediction.process.scenario_tabs_label") %>"
      >
        <% profit_contexts.each_with_index do |context, index| %>
          <% row_key = context.id || "new-#{index}" %>
          <button
            type="button"
            class="profit-prediction-process__scenario-tab<%= " is-active" if index.zero? %>"
            role="tab"
            aria-selected="<%= index.zero? %>"
            tabindex="<%= index.zero? ? 0 : -1 %>"
            title="<%= SkuProfitPredictionHelper::PROFIT_IDENTITY_COLUMNS.map { |field| profit_prediction_identity_value(context, field) }.join(" · ") %>"
            data-profit-prediction-target="scenarioTab"
            data-row-key="<%= row_key %>"
            data-action="click->profit-prediction#selectScenarioTab keydown->profit-prediction#selectScenarioTabWithKeyboard"
          >
            <span class="profit-prediction-process__scenario-tab-primary">
              <%= profit_prediction_identity_value(context, :platform) %>
              <%= profit_prediction_identity_value(context, :market) %>
            </span>
            <span class="profit-prediction-process__scenario-tab-secondary">
              <%= profit_prediction_identity_value(context, :delivery_mode) %>
              &middot;
              <%= profit_prediction_identity_value(context, :company_type) %>
            </span>
          </button>
        <% end %>
      </nav>
      <div class="profit-prediction-process__header-content">
        <h3 id="profit-prediction-process-title"><%= t("reports.profit_prediction.process.title") %></h3>
        <p data-profit-prediction-target="detailTitle"></p>
        <div class="profit-prediction-process__formula-summary">
          <strong><%= t("reports.profit_prediction.process.formula_summary.label") %></strong>
          <span data-profit-prediction-target="detailCostFormula"><%= t("reports.profit_prediction.process.formula_summary.total_cost", items: "-", total: "-") %></span>
          <span data-profit-prediction-target="detailProfitFormula"><%= t("reports.profit_prediction.process.formula_summary.profit", revenue: "-", total_cost: "-", profit: "-") %></span>
          <span data-profit-prediction-target="detailMarginFormula"><%= t("reports.profit_prediction.process.formula_summary.margin", profit: "-", revenue: "-", margin: "-") %></span>
        </div>
        <p class="profit-prediction-process__status" data-profit-prediction-target="detailStatus" role="status" aria-live="polite" hidden></p>
        <div class="profit-prediction-process__summary" aria-label="<%= t("reports.profit_prediction.process.summary") %>">
          <div class="profit-prediction-process__summary-item">
            <span><%= t("reports.profit_prediction.fields.price_rub") %></span>
            <strong data-profit-prediction-target="detailPrice">-</strong>
          </div>
          <div class="profit-prediction-process__summary-item">
            <span><%= t("reports.profit_prediction.result_fields.total_cost_cny") %></span>
            <strong data-profit-prediction-target="detailTotalCost">-</strong>
          </div>
          <div class="profit-prediction-process__summary-item">
            <span><%= t("reports.profit_prediction.result_fields.profit_cny") %></span>
            <strong data-profit-prediction-target="detailProfit">-</strong>
          </div>
          <div class="profit-prediction-process__summary-item">
            <span><%= t("reports.profit_prediction.result_fields.margin") %></span>
            <strong data-profit-prediction-target="detailMargin">-</strong>
          </div>
        </div>
      </div>
    </header>
    <table class="profit-prediction-process__table">
      <thead>
        <tr>
          <th><%= t("reports.profit_prediction.process.columns.item") %></th>
          <th><%= t("reports.profit_prediction.process.columns.parameters") %></th>
          <th><%= t("reports.profit_prediction.process.columns.source") %></th>
          <th><%= t("reports.profit_prediction.process.columns.calculation") %></th>
        </tr>
      </thead>
      <tbody data-profit-prediction-target="detailBody"></tbody>
    </table>
  </section>

