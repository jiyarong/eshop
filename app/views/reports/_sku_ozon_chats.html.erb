<% if @sku_ozon_chat_store %>
  <% tab_frame_data = @sku_detail_drawer ? { turbo_frame: @sku_detail_tab_frame_id } : {} %>
  <div class="sku-ozon-chat">
    <% if @sku_ozon_chat_stores.any? %>
      <div class="weekly-profit-filter-block sku-ozon-chat__store-filter">
        <div class="field field--full weekly-profit-store-field">
          <span class="field-label"><%= t("reports.ozon_chats.filters.store") %></span>
          <nav class="weekly-profit-tag-row" aria-label="<%= t("reports.ozon_chats.filters.store") %>">
            <% @sku_ozon_chat_stores.each do |store| %>
              <% active = store == @sku_ozon_chat_store %>
              <%= link_to store.store_name,
                          sku_detail_tab_path("ozon_chats", ozon_chat_store_id: store.id, ozon_chat_id: nil, ozon_chat_page: nil),
                          class: "weekly-profit-filter-tag ozon-chat-store-tag#{" is-active" if active}",
                          data: tab_frame_data,
                          aria: { pressed: active } %>
            <% end %>
          </nav>
        </div>
      </div>
    <% end %>

    <div class="ozon-chat-workspace">
      <aside class="ozon-chat-inbox" aria-label="<%= t("reports.ozon_chats.inbox.aria_label") %>">
        <div class="ozon-chat-inbox__header">
          <div>
            <h2><%= t("reports.ozon_chats.inbox.title") %></h2>
            <span><%= t("reports.ozon_chats.inbox.count", count: @sku_ozon_chats.total_count) %></span>
          </div>
        </div>
        <div class="ozon-chat-inbox__list">
          <% @sku_ozon_chats.each do |chat| %>
            <% active = chat == @sku_ozon_selected_chat %>
            <%= link_to sku_detail_tab_path("ozon_chats", ozon_chat_store_id: @sku_ozon_chat_store.id,
                                           ozon_chat_id: chat.chat_id, ozon_chat_page: @sku_ozon_chats.current_page),
                        class: "ozon-chat-thread #{"is-active" if active}", data: tab_frame_data,
                        aria: { current: ("page" if active) } do %>
              <span class="ozon-chat-thread__avatar">OZ</span>
              <span class="ozon-chat-thread__body">
                <span class="ozon-chat-thread__topline">
                  <strong><%= @sku.sku_code %></strong>
                  <time datetime="<%= chat.last_message_at&.iso8601 %>"><%= display_time(chat.last_message_at, format: "%m-%d %H:%M") %></time>
                </span>
                <span class="ozon-chat-thread__preview"><%= chat.last_message_preview.presence || t("reports.ozon_chats.messages.attachment") %></span>
              </span>
              <% if chat.unread_count.to_i.positive? %><span class="ozon-chat-thread__unread"><%= [chat.unread_count, 99].min %></span><% end %>
            <% end %>
          <% end %>
        </div>
        <% if @sku_ozon_chats.total_pages > 1 %>
          <nav class="ozon-chat-inbox__pagination" aria-label="<%= t("reports.ozon_chats.pagination.chats_aria_label") %>">
            <% previous_path = @sku_ozon_chats.prev_page && sku_detail_tab_path("ozon_chats", ozon_chat_store_id: @sku_ozon_chat_store.id, ozon_chat_page: @sku_ozon_chats.prev_page, ozon_chat_id: nil) %>
            <% next_path = @sku_ozon_chats.next_page && sku_detail_tab_path("ozon_chats", ozon_chat_store_id: @sku_ozon_chat_store.id, ozon_chat_page: @sku_ozon_chats.next_page, ozon_chat_id: nil) %>
            <%= previous_path ? link_to(content_tag(:i, "", class: "bi bi-chevron-left"), previous_path, data: tab_frame_data) : content_tag(:span, content_tag(:i, "", class: "bi bi-chevron-left"), aria: { disabled: true }) %>
            <strong><%= t("reports.ozon_chats.pagination.page", page: @sku_ozon_chats.current_page, pages: @sku_ozon_chats.total_pages) %></strong>
            <%= next_path ? link_to(content_tag(:i, "", class: "bi bi-chevron-right"), next_path, data: tab_frame_data) : content_tag(:span, content_tag(:i, "", class: "bi bi-chevron-right"), aria: { disabled: true }) %>
          </nav>
        <% end %>
      </aside>

      <section class="ozon-chat-detail">
        <% if @sku_ozon_selected_chat %>
          <header class="ozon-chat-detail__header">
            <div class="ozon-chat-detail__identity">
              <span class="ozon-chat-detail__avatar"><i class="bi bi-person" aria-hidden="true"></i></span>
              <div><h2><%= @sku.sku_code %></h2><span><%= t("reports.ozon_chats.detail.buyer_conversation") %></span></div>
            </div>
          </header>
          <div class="ozon-chat-messages">
            <% @sku_ozon_messages.each do |message| %>
              <% seller_message = message.user_type == "Seller" %>
              <article class="ozon-chat-message <%= seller_message ? "is-seller" : "is-customer" %>">
                <div class="ozon-chat-message__bubble">
                  <%= simple_format(message.message_text, {}, wrapper_tag: "div") if message.message_text.present? %>
                  <%= render "reports/ozon_chat_message_media", message: message, store: @sku_ozon_chat_store, chat: @sku_ozon_selected_chat %>
                  <footer><time datetime="<%= message.sent_at.iso8601 %>"><%= display_time(message.sent_at, format: "%m-%d %H:%M") %></time></footer>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="ozon-chat-empty"><i class="bi bi-chat-left-text" aria-hidden="true"></i><strong><%= t("reports.ozon_chats.empty.filtered_title") %></strong></div>
        <% end %>
      </section>
    </div>
  </div>
<% else %>
  <div class="empty-state"><%= t("reports.sku_detail.empty.ozon_chats") %></div>
<% end %>
