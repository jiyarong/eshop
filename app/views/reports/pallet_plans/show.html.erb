<% content_for :title, @plan.plan_no %>
<div class="report-stack">
  <header class="ozon-warehouse-heading"><div><h1 class="page-title"><%= @plan.plan_no %></h1><p class="page-subtitle"><%= @plan.store.store_name %> · <%= @plan.cluster_name %></p></div><%= link_to t("pallet_workbench.plans"), reports_pallet_plans_path, class: "button button-secondary" %></header>
  <section class="panel">
    <div class="pallet-workbench__actions"><strong><%= t("pallet_workbench.status") %></strong><%= pallet_workbench_status(@plan) %></div>
    <p><%= t("pallet_workbench.stock_status_hint") %></p>
    <% if can?(:manage_skus) %>
      <div class="pallet-workbench__actions">
        <% if @plan.editable? %><%= link_to t("pallet_workbench.edit"), edit_reports_pallet_plan_path(@plan), class: "button button-secondary" %><% end %>
        <% if @plan.status == 'draft' %><%= button_to t("pallet_workbench.confirm"), confirm_reports_pallet_plan_path(@plan), class: "button" %><% end %>
        <% next_status = { "reserved" => "packing", "packing" => "packed", "packed" => "dispatched" }[@plan.status] %>
        <% if next_status %>
          <%= form_with url: advance_reports_pallet_plan_path(@plan), class: "report-form", data: { turbo: false } do |form| %>
            <%= form.hidden_field :status, value: next_status %>
            <% if next_status == 'dispatched' %><div class="field"><%= form.label :platform_check_note, t("pallet_workbench.platform_check") %><%= form.text_field :platform_check_note, required: true, placeholder: t("pallet_workbench.platform_check_hint") %></div><% end %>
            <%= form.submit t("pallet_workbench.advance", status: t("pallet_workbench.statuses.#{next_status}")), class: "button" %>
          <% end %>
        <% end %>
        <% unless %w[closed cancelled].include?(@plan.status) %><%= button_to t("pallet_workbench.cancel"), cancel_reports_pallet_plan_path(@plan), class: "button button-secondary", form: { data: { turbo_confirm: t("pallet_workbench.cancel_confirm") } } %><% end %>
      </div>
    <% end %>
  </section>
  <section class="panel">
    <h2><%= t("pallet_workbench.supply_binding") %></h2>
    <dl class="pallet-workbench__metadata"><div><dt><%= t("pallet_workbench.supply_order_number") %></dt><dd><%= @plan.supply_order_number.presence || t("common.empty_value") %></dd></div><div><dt><%= t("pallet_workbench.platform_status") %></dt><dd><%= @plan.platform_status.presence || t("common.empty_value") %></dd></div><div><dt><%= t("pallet_workbench.updated_at") %></dt><dd><%= display_time(@plan.platform_synced_at) %></dd></div></dl>
    <% if @plan.sync_error.present? %><div role="alert" class="pallet-calculator__error"><%= @plan.sync_error %></div><% end %>
    <% if can?(:manage_skus) && !%w[closed cancelled].include?(@plan.status) %>
      <%= form_with url: bind_reports_pallet_plan_path(@plan), class: "report-form", data: { turbo: false } do |form| %><div class="field"><%= form.label :supply_order_number, t("pallet_workbench.supply_order_number") %><%= form.text_field :supply_order_number, value: @plan.supply_order_number, required: true %></div><%= form.submit t("pallet_workbench.bind"), class: "button" %><% end %>
      <% if @plan.ozon_order_id.present? %><%= button_to t("pallet_workbench.refresh"), refresh_reports_pallet_plan_path(@plan), class: "button button-secondary" %><% end %>
    <% end %>
  </section>
  <section class="panel"><h2><%= t("pallet_workbench.manifest") %></h2><%= table_viewport do %><table class="prod-tbl"><thead><tr><% %w[sku boxes units].each do |key| %><th><%= t("pallet_calculator.#{key}") %></th><% end %></tr></thead><tbody><% @plan.items.each do |item| %><tr><td><%= item.sku_code %></td><td><%= item.boxes %></td><td><%= item.units %></td></tr><% end %></tbody></table><% end %></section>
  <%= render "reports/pallet_workbenches/result", result: @result if @result.present? %>
</div>
