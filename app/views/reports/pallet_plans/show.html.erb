<% content_for :title, @plan.plan_no %>
<div class="report-stack" data-controller="ozon-supply"
     data-ozon-supply-status-url-value="<%= supply_submission_status_reports_pallet_plan_path(@plan, locale: I18n.locale) %>"
     data-ozon-supply-state-value="<%= @plan.ozon_supply_submission&.state %>"
     data-ozon-supply-plan-state-value="<%= @plan.status %>"
     data-ozon-supply-order-id-value="<%= @plan.ozon_order_id %>"
     data-ozon-supply-empty-value="<%= t('common.empty_value') %>"
     data-ozon-supply-poll-error-value="<%= t('pallet_workbench.supply_api.poll_error') %>">
  <header class="ozon-warehouse-heading"><div><h1 class="page-title"><%= @plan.plan_no %></h1><p class="page-subtitle"><%= @plan.store.store_name %> · <%= @plan.cluster_name %></p></div><%= link_to t("pallet_workbench.plans"), reports_pallet_plans_path, class: "button button-secondary" %></header>
  <section class="panel" data-ozon-supply-target="workflow"><%= render "workflow", plan: @plan %></section>
  <% if @plan.delivery_plan %><section class="panel"><%= link_to t("delivery_workbench.source_plan", number: @plan.delivery_plan.plan_no), reports_delivery_plan_path(@plan.delivery_plan) %></section><% end %>
  <section class="panel" data-ozon-supply-target="submissionPanel" <%= 'hidden' unless @plan.ozon_supply_submission %>>
    <div data-ozon-supply-target="content"><%= render "supply_submission", plan: @plan %></div>
  </section>
  <p role="status" data-ozon-supply-target="pollError"></p>
  <div data-ozon-supply-target="handoff"><%= render "supply_handoff", plan: @plan if can?(:manage_skus) && @plan.editable? %></div>
  <section class="panel" data-ozon-supply-target="binding"><%= render "supply_binding", plan: @plan %></section>
  <section class="panel"><h2><%= t("pallet_workbench.manifest") %></h2><%= table_viewport do %><table class="prod-tbl"><thead><tr><th><%= t("pallet_workbench.fields.sku_code") %></th><th><%= t("pallet_calculator.boxes") %></th><th><%= t("pallet_workbench.manifest_box_quantity") %></th><th><%= t("pallet_workbench.manifest_pallet_quantity") %></th><th><%= t("pallet_calculator.units") %></th></tr></thead><tbody><% @plan.items.each do |item| %><tr><td><%= item.sku_code %></td><td><%= item.boxes %></td><td><%= @allocations_by_sku.fetch([item.sku_code, "box"], 0) %></td><td><%= @allocations_by_sku.fetch([item.sku_code, "pallet"], 0) %></td><td><%= item.units %></td></tr><% end %></tbody></table><% end %></section>
  <%= render "reports/pallet_workbenches/result", result: @result if @result.present? %>
</div>
