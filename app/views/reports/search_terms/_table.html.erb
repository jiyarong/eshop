<section class="panel search-terms-table-panel">
  <div class="table-scroll">
    <table class="inventory-list-table search-terms-table" data-controller="table-row-expander">
      <thead>
        <tr>
          <th class="search-terms-expand-column"></th>
          <th><%= t("reports.search_terms.columns.sku") %></th>
          <th class="numeric"><%= t("reports.search_terms.columns.term_count") %></th>
          <% if @platform == "ozon" %><th class="numeric"><%= t("reports.search_terms.columns.ozon.search_volume") %></th><% end %>
          <th class="numeric"><%= t("reports.search_terms.columns.avg_position") %></th>
          <th class="numeric"><%= t("reports.search_terms.columns.#{@platform}.views") %></th>
          <% if @platform == "wb" %>
            <th class="numeric"><%= t("reports.search_terms.columns.wb.add_to_cart") %></th>
            <th class="numeric"><%= t("reports.search_terms.columns.wb.cart_conversion") %></th>
          <% end %>
          <th class="numeric"><%= t("reports.search_terms.columns.orders") %></th>
          <% if @platform == "ozon" %>
            <th class="numeric"><%= t("reports.search_terms.columns.ozon.revenue") %></th>
          <% end %>
          <th class="numeric"><%= t("reports.search_terms.columns.#{@platform}.conversion") %></th>
          <% if @platform == "wb" %><th class="numeric"><%= t("reports.search_terms.columns.wb.visibility") %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% if @rows.empty? %>
          <tr><td colspan="<%= @platform == 'wb' ? 10 : 9 %>" class="search-terms-empty"><%= t("reports.search_terms.empty") %></td></tr>
        <% else %>
          <% @rows.each do |row| %>
            <% comparisons = @row_comparisons.fetch(row[:sku_code], {}) %>
            <% expand_label = t("reports.search_terms.actions.expand", sku: row[:sku_code]) %>
            <% collapse_label = t("reports.search_terms.actions.collapse", sku: row[:sku_code]) %>
            <tr class="search-terms-sku-row">
              <td class="search-terms-expand-column">
                <% if row[:term_count].positive? %>
                  <button class="icon-button search-terms-expand-button" type="button"
                          aria-expanded="false" aria-label="<%= expand_label %>"
                          data-expand-label="<%= expand_label %>" data-collapse-label="<%= collapse_label %>"
                          data-action="table-row-expander#toggle">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                  </button>
                <% end %>
              </td>
              <td>
                <strong>
                  <% if local_assigns.fetch(:show_sku_link, true) %>
                    <%= sku_detail_drawer_link row[:sku], tab: "operation" %>
                  <% else %>
                    <%= row[:sku_code] %>
                  <% end %>
                </strong>
                <small class="search-terms-subline"><%= row[:product_name].presence || t("reports.search_terms.unknown_product") %></small>
              </td>
              <td class="numeric"><%= search_terms_metric_content(row[:term_count], comparisons[:term_count]) %></td>
              <% if @platform == "ozon" %><td class="numeric"><%= search_terms_metric_content(row[:search_volume], comparisons[:search_volume]) %></td><% end %>
              <td class="numeric"><%= search_terms_metric_content(row[:avg_position], comparisons[:avg_position], type: :decimal, comparison_type: :rank) %></td>
              <td class="numeric"><%= search_terms_metric_content(row[:views], comparisons[:views]) %></td>
              <% if @platform == "wb" %>
                <td class="numeric"><%= search_terms_metric_content(row[:add_to_cart], comparisons[:add_to_cart]) %></td>
                <td class="numeric"><%= search_terms_metric_content(row[:cart_conversion], comparisons[:cart_conversion], type: :percentage, comparison_type: :points) %></td>
              <% end %>
              <td class="numeric"><%= search_terms_metric_content(row[:orders], comparisons[:orders]) %></td>
              <% if @platform == "ozon" %>
                <td class="numeric"><%= search_terms_metric_content(row[:revenue], comparisons[:revenue], type: :currency) %></td>
              <% end %>
              <td class="numeric"><%= search_terms_metric_content(row[:conversion], comparisons[:conversion], type: :percentage, comparison_type: :points) %></td>
              <% if @platform == "wb" %><td class="numeric"><%= search_terms_metric_content(row[:visibility], comparisons[:visibility], type: :percentage, comparison_type: :points) %></td><% end %>
            </tr>
            <% if row[:term_count].positive? %>
              <tr class="wb-ads-product-detail-row search-terms-detail-row" hidden>
                <td colspan="<%= @platform == 'wb' ? 10 : 9 %>">
                  <%= turbo_frame_tag "search_terms_#{@platform}_#{dom_id(row[:sku])}",
                                      data: { lazy_src: reports_search_term_details_path(row[:sku_code], platform: @platform,
                                        store_id: @store.id, from_date: @from_date, to_date: @to_date, q: @query.presence) } do %>
                    <div class="search-terms-loading"><%= t("reports.search_terms.actions.loading") %></div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
