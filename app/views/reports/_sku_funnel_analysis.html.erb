<% scope = "reports.sku_detail.funnel_analysis" %>
<section class="panel sku-profit-analysis sku-funnel-analysis">
  <h2 class="section-title"><%= t("#{scope}.title") %></h2>
  <form action="<%= report_sku_path(@sku.sku_code) %>" method="get" class="report-form sku-operation-filter" <% if @sku_detail_drawer %>data-turbo-frame="<%= @sku_detail_tab_frame_id %>"<% end %>>
    <input type="hidden" name="tab" value="sales_funnel">
    <% if params[:locale].present? %><input type="hidden" name="locale" value="<%= params[:locale] %>"><% end %>
    <%= render "shared/time_range_selector", id: "sku-funnel-time-range", from_date: @funnel_from_date, to_date: @funnel_to_date, from_name: "funnel_from_date", to_name: "funnel_to_date", submit_on_apply: true %>
  </form>

  <% if @operation_funnel_error.present? %>
    <div class="empty-state"><%= t("#{scope}.load_error") %></div>
  <% elsif @funnel_analysis.present? %>
    <section class="sku-profit-analysis__section">
      <h3><%= t("#{scope}.overview") %></h3>
      <%= table_viewport(sticky_header: true, class_name: "sku-funnel-overview-viewport") do %>
        <table class="sku-profit-matrix">
          <thead><tr><th><%= t("#{scope}.metric") %></th>
            <% @funnel_analysis[:periods].each do |period| %>
              <th><div class="sku-profit-period__heading"><span class="sku-profit-period__key"><%= period[:key] %></span><% if period[:key] == "P0" %><span class="sku-profit-period__selected"><%= t("#{scope}.selected_period") %></span><% end %></div><div class="sku-profit-period__dates"><%= period[:from_date] %> ~ <%= period[:to_date] %></div></th>
            <% end %>
          </tr></thead>
          <tbody>
            <% @funnel_analysis[:common_metrics].reject { |metric| metric == :store_ending_inventory }.each do |metric| %>
              <tr><th><%= t("#{scope}.metrics.#{metric}") %></th>
                <% @funnel_analysis[:periods].each_with_index do |period, index| %>
                  <td><div class="weekly-profit-table-value"><%= sku_funnel_value(period[:sku_row], metric) %></div>
                    <% if index.positive? %><% comparison = sku_funnel_period_comparison(period[:sku_row], @funnel_analysis[:periods][index - 1][:sku_row], metric) %><% if comparison %><div class="weekly-profit-table-comparison <%= sku_operation_comparison_class(comparison) %>"><%= sku_operation_comparison_label(comparison) %></div><% end %><% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>

    <section class="sku-profit-analysis__section sku-profit-analysis__trend-toggle" data-controller="profit-trend-toggle" data-profit-trend-toggle-show-label-value="<%= t("#{scope}.show_common_trend") %>" data-profit-trend-toggle-hide-label-value="<%= t("#{scope}.hide_common_trend") %>">
      <button type="button" class="button sku-profit-analysis__trend-button" aria-expanded="false" data-profit-trend-toggle-target="button" data-action="profit-trend-toggle#toggle"><%= t("#{scope}.show_common_trend") %></button>
      <div data-profit-trend-toggle-target="content" hidden><%= turbo_frame_tag "sku_common_funnel_trend", src: report_sku_sales_funnel_trends_path(@sku.sku_code, view: "sku", trend_to_date: @funnel_to_date, locale: params[:locale]), loading: :lazy do %><div class="empty-state"><%= t("#{scope}.loading") %></div><% end %></div>
    </section>

    <section class="sku-profit-analysis__section" data-controller="profit-period-filter">
      <div class="sku-profit-analysis__store-heading"><h3><%= t("#{scope}.store_detail") %></h3><fieldset class="sku-profit-period-filter"><legend><%= t("#{scope}.period_filter") %></legend><div class="sku-profit-period-filter__options"><% @funnel_analysis[:periods].each do |period| %><label><input type="checkbox" value="<%= period[:key] %>" checked data-profit-period-filter-target="checkbox" data-action="profit-period-filter#update"><span><%= period[:key] %></span></label><% end %></div></fieldset></div>
      <%= table_viewport(sticky_header: true, class_name: "table-scroll--horizontal sku-funnel-store-viewport") do %><table class="sku-profit-store-table sku-funnel-store-table"><thead><tr>
        <th><%= t("#{scope}.metrics.store") %></th><th><%= t("#{scope}.metrics.period") %></th>
        <% @funnel_analysis[:store_metrics].each do |metric| %><th><%= t("#{scope}.metrics.#{metric}") %></th><% end %>
      </tr></thead>
        <% if @funnel_analysis[:store_groups].empty? %><tbody><tr><td colspan="<%= @funnel_analysis[:store_metrics].length + 2 %>" class="empty-state"><%= t("#{scope}.no_stores") %></td></tr></tbody><% end %>
        <% @funnel_analysis[:store_groups].each do |group| %><tbody data-profit-period-filter-target="group"><% @funnel_analysis[:periods].each_with_index do |period, index| %><% row = group[:rows_by_period][period[:key]] %><tr data-profit-period-filter-target="row" data-period="<%= period[:key] %>">
          <% if index.zero? %><th rowspan="4" data-profit-period-filter-store-cell><%= group[:platform].upcase %> / <%= group[:store_name] %></th><% end %>
          <td><strong><%= period[:key] %></strong><small><%= period[:from_date] %> - <%= period[:to_date] %></small></td>
          <% @funnel_analysis[:store_metrics].each do |metric| %><td><div class="weekly-profit-table-value"><%= sku_funnel_value(row, metric) %></div><% if index.positive? %><% comparison = sku_funnel_period_comparison(row, group[:rows_by_period][@funnel_analysis[:periods][index - 1][:key]], metric) %><% if comparison %><div class="weekly-profit-table-comparison <%= sku_operation_comparison_class(comparison) %>"><%= sku_operation_comparison_label(comparison) %></div><% end %><% end %></td><% end %>
        </tr><% end %></tbody><% end %>
      </table><% end %>
    </section>

    <% if @funnel_analysis[:store_groups].any? %>
      <section class="sku-profit-analysis__section"><%= turbo_frame_tag "sku_sales_funnel_trends", src: report_sku_sales_funnel_trends_path(@sku.sku_code, trend_to_date: @funnel_to_date, store_ids: @funnel_analysis[:store_groups].map { |group| group[:store_id] }, locale: params[:locale]), loading: :lazy do %><div class="empty-state"><%= t("#{scope}.loading") %></div><% end %></section>
    <% end %>
  <% end %>
</section>
