<% page = rows.current_page %>
<% page_count = rows.total_pages %>
<% query_params = request.query_parameters.symbolize_keys.except(:page, :jump_page, :current_page) %>

<div class="inventory-pagination-bar ozon-warehouse-pagination">
  <div class="pagination-meta">
    <div class="inventory-pagination-bar__summary">
      <%= t("reports.ozon_warehouses.pagination.#{@ozon_warehouse_view == 'clusters' ? 'cluster_summary' : 'product_summary'}", from: rows.offset_value + 1, to: [rows.offset_value + rows.limit_value, rows.total_count].min, total: rows.total_count) %>
    </div>
    <span class="pagination-chip"><%= t("reports.ozon_warehouses.pagination.page_chip", page: page, pages: page_count) %></span>
  </div>

  <div class="pagination-shell">
    <nav class="pagination-nav" aria-label="<%= t("reports.ozon_warehouses.pagination.#{@ozon_warehouse_view == 'clusters' ? 'cluster_aria_label' : 'product_aria_label'}") %>">
      <% if page > 1 %>
        <%= link_to warehouse_report_path(query_params.merge(page: page - 1)), class: "pg-btn pg-btn-nav", aria: { label: t("reports.ozon_warehouses.pagination.previous_page") } do %>
          <span aria-hidden="true">‹</span>
        <% end %>
      <% else %>
        <span class="pg-btn pg-btn-nav" aria-disabled="true">‹</span>
      <% end %>

      <% inventory_pagination_items(page, page_count).each do |item| %>
        <% if item.is_a?(Symbol) %>
          <span class="pg-ell" aria-hidden="true">…</span>
        <% elsif item == page %>
          <span class="pg-btn on"><%= item %></span>
        <% else %>
          <%= link_to item, warehouse_report_path(query_params.merge(page: item)), class: "pg-btn" %>
        <% end %>
      <% end %>

      <% if page < page_count %>
        <%= link_to warehouse_report_path(query_params.merge(page: page + 1)), class: "pg-btn pg-btn-nav", aria: { label: t("reports.ozon_warehouses.pagination.next_page") } do %>
          <span aria-hidden="true">›</span>
        <% end %>
      <% else %>
        <span class="pg-btn pg-btn-nav" aria-disabled="true">›</span>
      <% end %>
    </nav>

    <span class="pagination-divider" aria-hidden="true"></span>

    <%= form_with url: warehouse_report_path, method: :get, local: true, class: "pagination-jump", role: "group", aria: { label: t("reports.ozon_warehouses.pagination.jump_label") } do %>
      <% query_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag :current_page, page %>
      <span class="pagination-jump-label"><%= t("reports.ozon_warehouses.pagination.jump_label") %></span>
      <%= text_field_tag :jump_page, page, class: "pagination-jump-input", inputmode: "numeric", pattern: "[0-9]*", aria: { label: t("reports.ozon_warehouses.pagination.jump_label") } %>
      <%= submit_tag t("reports.ozon_warehouses.pagination.jump_action"), class: "pg-btn pg-btn-jump" %>
    <% end %>
  </div>
</div>
