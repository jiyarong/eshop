<%= turbo_frame_tag "sku_profit_trend" do %><% pa = "reports.sku_detail.profit_analysis" %>
  <div class="sku-profit-analysis__trends">
    <% if @profit_trend_error %><div class="empty-state"><%= t("#{pa}.trend_error") %></div><% else %>
      <% [[t("#{pa}.scale_trend"), @profit_scale_chart_option], [t("#{pa}.quality_trend"), @profit_quality_chart_option]].each do |title, option| %>
        <div class="sku-profit-analysis__chart-block"><h3><%= title %></h3><div data-controller="echarts" class="sku-profit-trend__chart-wrap"><div data-echarts-target="chart" class="sku-profit-trend__chart"></div><script type="application/json" data-echarts-target="data"><%= raw JSON.generate(option) %></script></div></div>
      <% end %>
    <% end %>
  </div>
<% end %>
