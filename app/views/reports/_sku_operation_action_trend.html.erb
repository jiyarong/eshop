<% trend_key = "erp.operation_actions.trends" %>
<%= form_with url: report_sku_path(@sku.sku_code), method: :get, class: "report-form sku-operation-trend-filter", data: { turbo_frame: (@sku_detail_drawer ? @sku_detail_tab_frame_id : nil) }.compact do |form| %>
  <%= hidden_field_tag :tab, "operation_actions" %>
  <%= hidden_field_tag :operation_actions_view, "trend" %>
  <%= hidden_field_tag :locale, params[:locale] if params[:locale].present? %>
  <div class="weekly-profit-filter-block">
    <div class="supply-order-primary-filters">
      <label class="field">
        <span class="label"><%= t("#{trend_key}.filters.store") %></span>
        <%= form.select :operation_trend_store_id,
                        options_for_select(@operation_trend_stores.map { |store| ["#{store.platform.upcase} / #{store.store_name}", store.id] }, @operation_trend_store&.id) %>
      </label>
      <div class="field field--time-range">
        <span class="label"><%= t("#{trend_key}.filters.date_range") %></span>
        <%= render "shared/time_range_selector", id: "sku-operation-trend-time-range", from_date: @operation_trend_from_date, to_date: @operation_trend_to_date, from_name: "operation_trend_from_date", to_name: "operation_trend_to_date" %>
      </div>
      <div class="weekly-profit-filter-actions"><%= form.submit t("erp.common.actions.filter"), class: "button weekly-profit-submit-button" %></div>
    </div>
  </div>
<% end %>

<% if @operation_trend.blank? %>
  <section class="panel"><div class="empty-state"><%= t("#{trend_key}.empty.no_store") %></div></section>
<% else %>
  <div class="sku-operation-trend-grid">
    <section class="panel sku-operation-trend-chart">
      <h3 class="section-title"><%= t("#{trend_key}.charts.combined") %></h3>
      <% unless @operation_trend[:has_price_history] || @operation_trend[:has_buyer_price] || @operation_trend[:has_seller_discount_price] || @operation_trend[:has_sales] || @operation_trend[:has_profit] %>
        <div class="empty-state"><%= t("#{trend_key}.empty.no_data") %></div>
      <% else %>
        <div data-controller="echarts" class="sku-profit-trend__chart-wrap"><div data-echarts-target="chart" class="sku-profit-trend__chart"></div><script type="application/json" data-echarts-target="data"><%= raw JSON.generate(@operation_trend[:chart_option]) %></script></div>
        <% unless @operation_trend[:has_price_history] %><p class="form-hint"><%= t("#{trend_key}.notices.no_listing_price_history") %></p><% end %>
        <% unless @operation_trend[:has_buyer_price] %><p class="form-hint"><%= t("#{trend_key}.notices.no_buyer_price") %></p><% end %>
      <% end %>
    </section>
  </div>
<% end %>
