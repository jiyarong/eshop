<% frame_id = params[:association_dom_id].present? ? "association_create_modal" : "erp_modal" %>
<%= turbo_frame_tag frame_id do %>
  <div class="erp-modal-backdrop association-picker__modal" data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <section class="erp-modal erp-modal--wide" role="dialog" aria-modal="true" aria-labelledby="supplier-modal-title">
      <div class="erp-modal__header"><h2 id="supplier-modal-title"><%= t("erp.suppliers.actions.add") %></h2><button class="icon-button" type="button" aria-label="<%= t("common.actions.close") %>" data-action="modal#close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
      <%= render "form", supplier: @supplier, modal: true %>
    </section>
  </div>
<% end %>
