<% content_for :page_heading, @supplier.name %>
<div class="resource-header">
  <div><p class="resource-eyebrow"><%= t("erp.suppliers.show.eyebrow") %></p><h1 class="page-title"><%= @supplier.name %></h1></div>
  <div class="resource-actions">
    <%= link_to t("erp.common.actions.back"), erp_suppliers_path(current_locale_params), class: "button button-secondary" %>
    <%= link_to t("erp.common.actions.edit"), erp_edit_supplier_path(@supplier, current_locale_params), class: "button" if can?(:manage_purchases) %>
  </div>
</div>

<div class="report-stack">
  <section class="panel">
    <h2 class="section-title"><%= t("erp.suppliers.show.summary") %></h2>
    <dl class="definition-list">
      <dt><%= t("erp.suppliers.fields.origin") %></dt><dd><%= erp_value(@supplier.origin) %></dd>
      <dt><%= t("erp.suppliers.fields.invoice_type") %></dt><dd><%= @supplier.invoice_type ? t("erp.suppliers.invoice_types.#{@supplier.invoice_type}") : erp_value(nil) %></dd>
      <dt><%= t("erp.suppliers.fields.channel") %></dt><dd><%= @supplier.channel ? t("erp.suppliers.channels.#{@supplier.channel}") : erp_value(nil) %></dd>
      <dt><%= t("erp.suppliers.fields.online_url") %></dt><dd><%= @supplier.online_url.present? ? link_to(@supplier.online_url, @supplier.online_url, target: "_blank", rel: "noreferrer noopener") : erp_value(nil) %></dd>
      <dt><%= t("erp.suppliers.fields.developer") %></dt><dd><%= erp_value(@supplier.developer&.display_name) %></dd>
      <dt><%= t("erp.suppliers.fields.purchaser") %></dt><dd><%= erp_value(@supplier.purchaser&.display_name) %></dd>
      <dt><%= t("erp.suppliers.fields.factory_audited") %></dt><dd><%= t(@supplier.factory_audited? ? "common.yes" : "common.no") %></dd>
      <dt><%= t("erp.suppliers.fields.credit_terms") %></dt><dd><%= t(@supplier.credit_terms? ? "common.yes" : "common.no") %></dd>
      <dt><%= t("erp.suppliers.fields.supplier_grade") %></dt><dd><%= erp_value(@supplier.supplier_grade) %></dd>
      <dt><%= t("erp.suppliers.fields.supplier_evaluation") %></dt><dd><%= erp_value(@supplier.supplier_evaluation) %></dd>
      <dt><%= t("erp.suppliers.fields.contact_name") %></dt><dd><%= erp_value(@supplier.contact_name) %></dd>
      <dt><%= t("erp.suppliers.fields.phone") %></dt><dd><%= erp_value(@supplier.phone) %></dd>
      <dt><%= t("erp.suppliers.fields.wechat") %></dt><dd><%= erp_value(@supplier.wechat) %></dd>
      <dt><%= t("erp.suppliers.fields.address") %></dt><dd><%= erp_value(@supplier.address) %></dd>
      <dt><%= t("erp.common.memo") %></dt><dd><%= erp_value(@supplier.memo) %></dd>
    </dl>
  </section>

  <%= render "shared/attachments",
             attachments: @attachments,
             dom_id_prefix: "supplier-#{@supplier.id}-attachments",
             can_manage: can?(:manage_purchases),
             attach_type_options: Ec::Attachment::COMPANY_ATTACH_TYPES.map { |type| [t("erp.suppliers.attachment_types.#{type}"), type] },
             upload_path: attachments_erp_supplier_path(@supplier, current_locale_params),
             download_path_for: ->(attachment) { attachment_erp_supplier_path(@supplier, attachment, current_locale_params) },
             preview_path_for: ->(attachment) { preview_attachment_erp_supplier_path(@supplier, attachment, current_locale_params) },
             edit_path_for: ->(attachment) { edit_attachment_erp_supplier_path(@supplier, attachment, current_locale_params) },
             delete_path_for: ->(attachment) { attachment_erp_supplier_path(@supplier, attachment, current_locale_params) } %>

  <section class="panel">
    <h2 class="section-title"><%= t("erp.suppliers.show.purchase_orders") %></h2>
    <div class="table-scroll"><table><thead><tr><th><%= t("erp.suppliers.purchase_orders.order_no") %></th><th><%= t("erp.common.status") %></th><th><%= t("erp.suppliers.purchase_orders.ordered_on") %></th><th><%= t("erp.suppliers.purchase_orders.amount") %></th></tr></thead><tbody>
      <% @purchase_orders.each do |order| %><tr><td><%= link_to order.order_no, erp_purchase_order_path(order) %></td><td><%= order.status %></td><td><%= order.ordered_on %></td><td><%= erp_value(order.goods_amount_cny) %></td></tr><% end %>
      <% if @purchase_orders.empty? %><tr><td colspan="4" class="empty-state"><%= t("erp.suppliers.purchase_orders.none") %></td></tr><% end %>
    </tbody></table></div>
  </section>
</div>
