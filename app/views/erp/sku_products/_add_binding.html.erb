<section class="sku-product-binding-panel">
  <h2 class="section-title"><%= t("erp.sku_products.sections.add_binding") %></h2>

  <section class="card product-filter-card">
    <%= form_with url: erp_sku_sku_products_path(@sku), method: :get, local: true, class: "product-filter-form" do |form| %>
      <div class="product-search-control">
        <i class="bi bi-search" aria-hidden="true"></i>
        <%= form.search_field :raw_product_query, value: @raw_product_query, placeholder: t("erp.sku_products.filters.raw_product_query_placeholder"), class: "input" %>
      </div>
      <div class="field product-filter-field">
        <%= form.label :raw_product_platform, t("erp.sku_products.filters.platform") %>
        <%= form.select :raw_product_platform,
                        [[t("erp.sku_products.filters.all_platforms"), ""], [t("common.platforms.ozon"), "ozon"], [t("common.platforms.wb"), "wb"]],
                        { selected: @raw_product_platform }, class: "select" %>
      </div>
      <div class="field product-filter-field">
        <%= form.label :binding_status, t("erp.sku_products.filters.binding_status") %>
        <%= form.select :binding_status,
                        [[t("erp.sku_products.filters.available"), "available"], [t("erp.sku_products.filters.bound"), "bound"]],
                        { selected: @binding_status }, class: "select" %>
      </div>
      <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i><%= t("erp.common.actions.filter") %></button>
      <%= link_to erp_sku_sku_products_path(@sku, current_locale_params), class: "btn btn-outline" do %>
        <i class="bi bi-x-lg" aria-hidden="true"></i><%= t("erp.common.actions.reset") %>
      <% end %>
    <% end %>
  </section>

  <% if @sku_product.errors.any? %>
    <div class="panel error-box"><ul><% @sku_product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>

  <%= form_with url: erp_sku_sku_products_path(@sku), method: :post, local: true do %>
    <div class="table-scroll">
      <table class="raw-product-options">
        <thead><tr>
          <th><%= t("erp.sku_products.fields.select") %></th><th><%= t("erp.common.platform") %></th>
          <th><%= t("erp.sku_products.fields.store") %></th><th><%= t("erp.sku_products.fields.product_id") %></th>
          <th><%= t("erp.sku_products.fields.offer_id") %></th><th><%= t("erp.sku_products.fields.product_name") %></th>
          <th><%= t("erp.sku_products.fields.product_attributes_link") %></th><th><%= t("erp.sku_products.fields.store_link") %></th>
          <th><%= t("erp.common.status") %></th>
        </tr></thead>
        <tbody>
          <% @raw_product_options.each do |product| %>
            <tr>
              <td><%= product[:bound] ? "-" : check_box_tag("raw_product_keys[]", product[:key], false, id: "raw_product_#{product[:key].parameterize}") %></td>
              <td><%= t("common.platforms.#{product[:platform]}", default: product[:platform]) %></td><td><%= product[:store_name] %></td>
              <td><%= product[:product_id] %></td><td><%= erp_value(product[:offer_id]) %></td>
              <td><span data-controller="long-text" data-long-text-limit-value="50"><%= erp_value(product[:product_name]) %></span></td>
              <td><%= link_to t("erp.sku_products.actions.view_attributes"), erp_platform_product_path(product[:platform], product[:store_id], product[:product_id]) %></td>
              <td><% edit_url = product_edit_url(product[:platform], product[:platform_sku_id].presence || product[:product_id]) %><%= edit_url ? link_to(t("erp.sku_products.actions.open_platform_product"), edit_url, target: "_blank", rel: "noreferrer noopener") : "-" %></td>
              <td><%= product[:bound] ? t("erp.sku_products.status.bound") : t("erp.sku_products.status.available") %></td>
            </tr>
          <% end %>
          <% if @raw_product_options.empty? %><tr><td colspan="9" class="empty-state"><%= t("erp.sku_products.empty.no_raw_products") %></td></tr><% end %>
        </tbody>
      </table>
    </div>
    <% if @binding_status == "available" %><button class="button" type="submit"><%= t("erp.sku_products.actions.add_binding") %></button><% end %>
  <% end %>
  <% if @raw_product_options.total_pages > 1 %>
    <%= render "pagination", raw_products: @raw_product_options %>
  <% end %>
</section>
