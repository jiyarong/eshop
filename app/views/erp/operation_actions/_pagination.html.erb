<% page = operation_actions.current_page %>
<% page_count = operation_actions.total_pages %>
<% page_param = local_assigns.fetch(:page_param, :page).to_sym %>
<% path_builder = local_assigns.fetch(:path_builder, ->(params) { erp_operation_actions_path(params) }) %>
<% turbo_frame = local_assigns[:turbo_frame] %>
<% query_params = request.query_parameters.symbolize_keys.except(page_param, :page, :jump_page, :current_page) %>

<div class="inventory-pagination-bar">
  <div class="pagination-meta">
    <div class="inventory-pagination-bar__summary">
      <%= t("erp.operation_actions.pagination.summary",
            from: operation_actions.offset_value + 1,
            to: operation_actions.offset_value + operation_actions.length,
            total: operation_actions.total_count) %>
    </div>
    <span class="pagination-chip"><%= t("erp.operation_actions.pagination.page_chip", page: page, pages: page_count) %></span>
  </div>
  <div class="pagination-shell">
    <nav class="pagination-nav" aria-label="<%= t("erp.operation_actions.pagination.aria_label") %>">
      <% if page > 1 %>
        <%= link_to "‹", path_builder.call(query_params.merge(page_param => page - 1)), class: "pg-btn pg-btn-nav", data: { turbo_frame: turbo_frame }.compact, aria: { label: t("erp.operation_actions.pagination.previous_page") } %>
      <% else %>
        <span class="pg-btn pg-btn-nav" aria-disabled="true">‹</span>
      <% end %>
      <% inventory_pagination_items(page, page_count).each do |item| %>
        <% if item.is_a?(Symbol) %>
          <span class="pg-ell" aria-hidden="true">…</span>
        <% elsif item == page %>
          <span class="pg-btn on"><%= item %></span>
        <% else %>
          <%= link_to item, path_builder.call(query_params.merge(page_param => item)), class: "pg-btn", data: { turbo_frame: turbo_frame }.compact %>
        <% end %>
      <% end %>
      <% if page < page_count %>
        <%= link_to "›", path_builder.call(query_params.merge(page_param => page + 1)), class: "pg-btn pg-btn-nav", data: { turbo_frame: turbo_frame }.compact, aria: { label: t("erp.operation_actions.pagination.next_page") } %>
      <% else %>
        <span class="pg-btn pg-btn-nav" aria-disabled="true">›</span>
      <% end %>
    </nav>
    <span class="pagination-divider" aria-hidden="true"></span>
    <%= form_with url: path_builder.call({}), method: :get, local: true, class: "pagination-jump", role: "group", aria: { label: t("erp.operation_actions.pagination.jump_label") }, data: { turbo_frame: turbo_frame }.compact do %>
      <% query_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag :current_page, page %>
      <span class="pagination-jump-label"><%= t("erp.operation_actions.pagination.jump_label") %></span>
      <%= text_field_tag :jump_page,
                         page,
                         class: "pagination-jump-input",
                         inputmode: "numeric",
                         pattern: "[0-9]*",
                         aria: { label: t("erp.operation_actions.pagination.jump_label") } %>
      <%= submit_tag t("erp.operation_actions.pagination.jump_action"), class: "pg-btn pg-btn-jump" %>
    <% end %>
  </div>
</div>
