<% if @ai_diagnosis_event_tags.present? %>
  <div class="ai-diagnosis-event-filter" aria-label="<%= t("erp.ai_diagnosis_event_filter.aria_label") %>">
    <span class="ai-diagnosis-event-filter__label"><%= t("erp.ai_diagnosis_event_filter.label") %></span>
    <div class="ai-diagnosis-event-filter__tag-groups">
      <% @ai_diagnosis_event_tags.group_by { |tag| tag[:severity] == "warning" }.each do |warning, tags| %>
        <% tags_markup = capture do %>
          <% tags.each do |tag| %>
            <% event_type = tag[:event_type] %>
            <% active = event_type == @ai_diagnosis_event_type %>
            <% query = request.query_parameters.symbolize_keys.except(:page, :jump_page, :current_page, :ai_event_type) %>
            <% query[:ai_event_type] = event_type unless active %>
            <%= link_to url_for(only_path: true, **query), class: class_names("ai-diagnosis-event-tag", "ai-diagnosis-event-tag--warning": warning, "is-active": active), aria: { pressed: active } do %>
              <span><%= t("erp.ai_diagnosis_event_filter.event_types.#{event_type}", default: event_type.to_s.humanize) %></span>
              <span class="ai-diagnosis-event-tag__count"><%= tag[:count] %></span>
            <% end %>
          <% end %>
        <% end %>
        <% if warning %>
          <div class="ai-diagnosis-collapsible-tags"
               data-controller="collapsible-tag-row"
               data-collapsible-tag-row-expand-label-value="<%= t("shared.collapsible_tags.show_more") %>"
               data-collapsible-tag-row-collapse-label-value="<%= t("shared.collapsible_tags.show_less") %>">
            <div class="ai-diagnosis-event-filter__tags ai-diagnosis-event-filter__tags--warning" data-collapsible-tag-row-target="content"><%= tags_markup %></div>
            <button type="button" class="ai-diagnosis-collapsible-tags__toggle" data-collapsible-tag-row-target="toggle" data-action="collapsible-tag-row#toggle" hidden></button>
          </div>
        <% else %>
          <div class="ai-diagnosis-event-filter__tags"><%= tags_markup %></div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
<% advice_tags = Array(local_assigns[:advice_tags]) %>
<% if advice_tags.present? %>
  <div class="ai-diagnosis-event-filter ai-diagnosis-event-filter--advice" aria-label="<%= t("erp.ai_diagnosis_event_filter.advice_aria_label") %>">
    <span class="ai-diagnosis-event-filter__label"><%= t("erp.ai_diagnosis_event_filter.advice_label") %></span>
    <div class="ai-diagnosis-event-filter__tags">
      <% advice_tags.each do |tag| %>
        <% event_type = tag[:event_type] %>
        <% active = event_type == local_assigns[:selected_advice_type] %>
        <% query = request.query_parameters.symbolize_keys.except(:page, :jump_page, :current_page, :ai_advice_type) %>
        <% query[:ai_advice_type] = event_type unless active %>
        <%= link_to url_for(only_path: true, **query), class: class_names("ai-diagnosis-event-tag", "ai-diagnosis-event-tag--advice", "is-active": active), aria: { pressed: active } do %>
          <span><%= t("erp.ai_diagnosis_event_filter.event_types.#{event_type}", default: event_type.to_s.humanize) %></span>
          <span class="ai-diagnosis-event-tag__count"><%= tag[:count] %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
