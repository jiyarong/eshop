<% picker_id = local_assigns.fetch(:dom_id) %>
<% selected_record = local_assigns[:selected_record] %>
<div class="field association-picker"
     data-controller="association-picker"
     data-association-picker-id-value="<%= picker_id %>"
     data-association-picker-search-url-value="<%= search_url %>"
     data-association-picker-empty-label-value="<%= empty_label %>"
     data-action="association-picker:selected@window->association-picker#selectCreated">
  <label for="<%= "#{picker_id}-query" %>"><%= label %></label>
  <%= hidden_field_tag field_name, selected_record&.id, data: { association_picker_target: "input" } %>
  <div class="association-picker__control">
    <input id="<%= "#{picker_id}-query" %>"
           class="input association-picker__query"
           type="search"
           value="<%= selected_record&.name %>"
           placeholder="<%= placeholder %>"
           autocomplete="off"
           role="combobox"
           aria-autocomplete="list"
           aria-controls="<%= "#{picker_id}-results" %>"
           aria-expanded="false"
           data-association-picker-target="query"
           data-action="input->association-picker#search keydown->association-picker#navigate blur->association-picker#closeSoon">
    <button class="icon-button" type="button" title="<%= create_label %>" aria-label="<%= create_label %>" data-action="association-picker#openCreate">
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
    </button>
  </div>
  <div id="<%= "#{picker_id}-results" %>" class="association-picker__results" role="listbox" data-association-picker-target="results" hidden></div>
  <template data-association-picker-target="emptyTemplate">
    <div class="association-picker__empty"><%= empty_label %></div>
  </template>
  <span class="form-hint"><%= hint %></span>
  <span class="sr-only" role="status" aria-live="polite" data-association-picker-target="status"></span>
  <span hidden data-association-picker-target="createUrl"><%= create_url %></span>
</div>
