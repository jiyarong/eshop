<% page = skus.current_page %>
<% page_count = skus.total_pages %>
<% query_params = request.query_parameters.symbolize_keys.except(:page, :jump_page, :current_page) %>

<div class="inventory-pagination-bar">
  <div class="pagination-meta">
    <div class="inventory-pagination-bar__summary"><%= t("operator_skus.pagination.summary", from: skus.offset_value + 1, to: [skus.offset_value + skus.limit_value, skus.total_count].min, total: skus.total_count) %></div>
    <span class="pagination-chip"><%= t("operator_skus.pagination.page", page: page, pages: page_count) %></span>
  </div>
  <div class="pagination-shell">
    <nav class="pagination-nav" aria-label="<%= t("operator_skus.pagination.label") %>">
      <% if page > 1 %>
        <%= link_to operator_skus_path(query_params.merge(page: page - 1)), class: "pg-btn pg-btn-nav", aria: { label: t("operator_skus.pagination.previous") } do %>
          <span aria-hidden="true">‹</span>
        <% end %>
      <% else %>
        <span class="pg-btn pg-btn-nav" aria-disabled="true">‹</span>
      <% end %>

      <% inventory_pagination_items(page, page_count).each do |item| %>
        <% if item.is_a?(Symbol) %>
          <span class="pg-ell" aria-hidden="true">…</span>
        <% elsif item == page %>
          <span class="pg-btn on"><%= item %></span>
        <% else %>
          <%= link_to item, operator_skus_path(query_params.merge(page: item)), class: "pg-btn" %>
        <% end %>
      <% end %>

      <% if page < page_count %>
        <%= link_to operator_skus_path(query_params.merge(page: page + 1)), class: "pg-btn pg-btn-nav", aria: { label: t("operator_skus.pagination.next") } do %>
          <span aria-hidden="true">›</span>
        <% end %>
      <% else %>
        <span class="pg-btn pg-btn-nav" aria-disabled="true">›</span>
      <% end %>
    </nav>

    <span class="pagination-divider" aria-hidden="true"></span>

    <%= form_with url: operator_skus_path, method: :get, local: true, class: "pagination-jump", role: "group", aria: { label: t("operator_skus.pagination.jump_label") } do %>
      <% query_params.each do |key, value| %>
        <% if value.is_a?(Array) %>
          <% value.each do |item| %>
            <%= hidden_field_tag "#{key}[]", item %>
          <% end %>
        <% else %>
          <%= hidden_field_tag key, value %>
        <% end %>
      <% end %>
      <%= hidden_field_tag :current_page, page %>
      <span class="pagination-jump-label"><%= t("operator_skus.pagination.jump_label") %></span>
      <%= text_field_tag :jump_page,
                         page,
                         class: "pagination-jump-input",
                         inputmode: "numeric",
                         pattern: "[0-9]*",
                         aria: { label: t("operator_skus.pagination.jump_label") } %>
      <%= submit_tag t("operator_skus.pagination.jump_action"), class: "pg-btn pg-btn-jump" %>
    <% end %>
  </div>
</div>
