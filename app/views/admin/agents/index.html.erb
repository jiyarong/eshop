<% content_for :title, t("admin.agents.index.title") %>
<% content_for :page_heading, t("admin.agents.index.title") %>

<div class="ai-admin-heading">
  <h1 class="page-title"><%= t("admin.agents.index.title") %></h1>
  <%= link_to new_admin_agent_path, class: "button" do %>
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    <span><%= t("admin.agents.actions.new") %></span>
  <% end %>
</div>

<%= render "admin/shared/ai_navigation", section: :agents %>

<section class="panel ai-agent-filters">
  <div class="ai-agent-filters__group" role="group" aria-labelledby="agent-status-filter-label">
    <span id="agent-status-filter-label" class="ai-agent-filters__label"><%= t("admin.agents.fields.status") %></span>
    <% [ nil, "enabled", "disabled" ].each do |status| %>
      <%= link_to status ? t("admin.agents.statuses.#{status}") : t("admin.agents.filters.all_statuses"),
                  admin_agents_path(status: status, agent_type: @agent_type),
                  class: class_names("ai-tag ai-agent-filters__option", "is-active": @status == status),
                  aria: { current: (@status == status ? "true" : nil) } %>
    <% end %>
  </div>
  <div class="ai-agent-filters__group" role="group" aria-labelledby="agent-type-filter-label">
    <span id="agent-type-filter-label" class="ai-agent-filters__label"><%= t("admin.agents.fields.agent_type") %></span>
    <% [ nil, *Agent.agent_types.keys ].each do |agent_type| %>
      <%= link_to agent_type ? t("admin.agents.agent_types.#{agent_type}") : t("admin.agents.filters.all_types"),
                  admin_agents_path(status: @status, agent_type: agent_type),
                  class: class_names("ai-tag ai-agent-filters__option", "is-active": @agent_type == agent_type),
                  aria: { current: (@agent_type == agent_type ? "true" : nil) } %>
    <% end %>
  </div>
</section>

<section class="panel ai-table-panel table-list-card">
  <%= table_viewport(class_name: "table-list-viewport", sticky_header: true) do %>
    <table class="ai-admin-table ai-agent-table">
      <thead>
        <tr>
          <th><%= t("admin.agents.fields.name") %></th>
          <th><%= t("admin.agents.fields.agent_type") %></th>
          <th><%= t("admin.agents.fields.model_id") %></th>
          <th><%= t("admin.agents.fields.status") %></th>
          <th><%= t("admin.agents.fields.updated_at") %></th>
          <th><%= t("admin.agents.fields.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @agents.each do |agent| %>
          <tr>
            <td>
              <div class="ai-agent-identity">
                <% if agent.avatar.attached? %>
                  <%= image_tag agent.avatar, class: "ai-agent-avatar", alt: t("admin.agents.avatar_alt", name: agent.name) %>
                <% else %>
                  <span class="ai-agent-avatar ai-agent-avatar--fallback" aria-hidden="true"><%= agent.name.to_s.first&.upcase %></span>
                <% end %>
                <div class="ai-agent-identity__copy">
                  <div class="ai-agent-identity__name">
                    <strong><%= agent.name %></strong>
                    <% origin = Agent::DEFINITIONS.key?(agent.code) ? "built_in" : "custom" %>
                    <span class="ai-tag ai-agent-origin--<%= origin.dasherize %>"><%= t("admin.agents.origins.#{origin}") %></span>
                  </div>
                  <code><%= agent.code %></code>
                  <% if agent.description.present? %>
                    <span><%= agent.description %></span>
                  <% end %>
                </div>
              </div>
            </td>
            <td><%= t("admin.agents.agent_types.#{agent.agent_type}") %></td>
            <td><code class="ai-model-code"><%= agent.model_id %></code></td>
            <td>
              <span class="status-pill <%= agent.enabled? ? "is-active" : "is-muted" %>">
                <span class="status-pill__dot" aria-hidden="true"></span>
                <%= agent.enabled? ? t("admin.agents.statuses.enabled") : t("admin.agents.statuses.disabled") %>
              </span>
            </td>
            <td><%= display_time(agent.updated_at) %></td>
            <td>
              <% if agent.available_for_conversation? %>
                <%= button_to ai_conversations_path,
                              params: { agent_code: agent.code },
                              class: "ai-row-action",
                              form: { data: { turbo: false } } do %>
                  <i class="bi bi-chat-dots" aria-hidden="true"></i>
                  <span><%= t("admin.agents.actions.start_conversation") %></span>
                <% end %>
              <% end %>
              <%= link_to edit_admin_agent_path(agent.code), class: "ai-row-action" do %>
                <i class="bi bi-pencil" aria-hidden="true"></i>
                <span><%= t("common.actions.edit") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
